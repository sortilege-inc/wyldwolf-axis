{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wyldwolf-axis",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // The app's own origin — the only non-localhost origin the Worker
    // answers to (CORS for fetches, Origin check for sockets).
    "ALLOWED_ORIGIN": "https://sortilege-inc.github.io"
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSION_ROOM", "class_name": "SessionRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }]
}
