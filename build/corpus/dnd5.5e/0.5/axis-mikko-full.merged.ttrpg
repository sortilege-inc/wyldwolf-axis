            ^"Armor Training" LIST OF STRING ["Light", "Medium", "Shields"]
            ^"Weapon Proficiencies" LIST OF STRING ["Simple", "Martial"]
            ^"Skill Choices" DEF {
                ^"Count" INTEGER 3
