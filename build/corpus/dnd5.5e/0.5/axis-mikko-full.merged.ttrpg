    # source: spell (page 164)
    #tGQ0nHeX5wHYHN8DHG0Uw3rn ^"Speak with Dead" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 3
            ^"School" STRING "Necromancy"
            ^"Casting Time" STRING "Action"
            ^"Range" STRING "10 feet"
            ^"Components" STRING "V, S, M (burning incense)"
            ^"Duration" STRING "10 minutes"
            ^"Description" STRING "You grant the semblance of life to a corpse of your choice within range, allowing it to answer questions you pose. The corpse must have a mouth, and this spell fails if the deceased creature was Undead when it died. The spell also fails if the corpse was the target of this spell within the past 10 days. Until the spell ends, you can ask the corpse up to five questions. The corpse knows only what it knew in life, including the languages it knew. Answers are usually brief, cryptic, or repetitive, and the corpse is under no compulsion to offer a truthful answer if you are antagonistic toward it or it recognizes you as an enemy. This spell doesn’t return the creature’s soul to its body, only its animating spirit. Thus, the corpse can’t learn new information, doesn’t comprehend anything that has happened since it died, and can’t speculate about future events."
            ^"Classes" LIST OF STRING ["Bard", "Cleric", "Wizard"]
        }
    }
    # source: spell (page 164)
    #t9Vys8OG6NXCPml53fVXEXbf ^"Speak with Plants" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 3
            ^"School" STRING "Transmutation"
            ^"Casting Time" STRING "Action"
            ^"Range" STRING "Self"
            ^"Components" STRING "V, S"
            ^"Duration" STRING "10 minutes"
            ^"Description" STRING "You imbue plants in an immobile 30-foot Emanation with limited sentience and animation, giving them the ability to communicate with you and follow your simple commands. You can question plants about events in the spell’s area within the past day, gaining information about creatures that have passed, weather, and other circumstances. You can also turn Difficult Terrain caused by plant growth (such as thickets and undergrowth) into ordinary terrain that lasts for the duration. Or you can turn ordinary terrain where plants are present into Difficult Terrain that lasts for the duration. The spell doesn’t enable plants to uproot themselves and move about, but they can move their branches, tendrils, and stalks for you. If a Plant creature is in the area, you can communicate with it as if you shared a common language."
            ^"Classes" LIST OF STRING ["Bard", "Druid", "Ranger"]
        }
    }
