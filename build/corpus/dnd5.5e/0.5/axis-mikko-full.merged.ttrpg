                    ^"Spell Slots" INTEGER 2
                    ^"Slot Level" INTEGER 2
                }
                ^"Level 5" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Eldritch Invocations" INTEGER 5
                    ^"Cantrips" INTEGER 3
                    ^"Prepared Spells" INTEGER 6
                    ^"Spell Slots" INTEGER 2
                    ^"Slot Level" INTEGER 3
                }
                ^"Level 6" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Subclass feature"]
                    ^"Eldritch Invocations" INTEGER 5
