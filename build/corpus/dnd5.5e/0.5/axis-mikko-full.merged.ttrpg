    # source: species (page 86)
    #tYNtHAsPNbRQ7SHfGGJxuix3 ^"Orc" DEF {
        EXTENDS ^"Species"
        PROPERTIES {
            ^"Description" STRING "As an Orc, you have these special traits."
            ^"Creature Type" STRING "Humanoid"
            ^"Size" STRING "Medium (about 6–7 feet tall)"
            ^"Speed" STRING "30 feet"
