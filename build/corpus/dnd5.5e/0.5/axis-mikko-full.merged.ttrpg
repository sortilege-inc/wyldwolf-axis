    # source: equipment (page 99)
    #tAqMnDk7R5mcwZGhDjcClMte ^"Spell Scroll (Cantrip)" DEF {
        EXTENDS ^"Adventuring Gear"
        PROPERTIES {
            ^"Category" STRING "Adventuring Gear"
            ^"Cost" DEF {
                ^"Amount" INTEGER 30
                ^"Unit" STRING "GP"
            }
            ^"Weight" STRING "—"
            ^"Description" STRING "A Spell Scroll (Cantrip) or Spell Scroll (Level 1) is a magic item that bears the words of a cantrip or level 1 spell, respectively, determined by the scroll's creator. If the spell is on your class's spell list, you can read the scroll and cast the spell using its normal casting time and without providing any Material components. If the spell requires a saving throw or an attack roll, the spell save DC is 13, and the attack bonus is +5. The scroll disintegrates when the casting is completed."
        }
    }
