    # source: spell (page 151)
    #tSgQVwHHFYeAEJWMBqmiF7jT ^"Passwall" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 5
            ^"School" STRING "Transmutation"
            ^"Casting Time" STRING "Action"
            ^"Range" STRING "30 feet"
