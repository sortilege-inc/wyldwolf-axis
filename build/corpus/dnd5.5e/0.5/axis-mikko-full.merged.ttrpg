            }
            #tr3mZu8hqkhIuuFucPct4TYe ^"Dwarven Resilience" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You have Resistance to Poison damage. You also have Advantage on saving throws you make to avoid or end the Poisoned condition."
            }
            #tn1eBw5Epj8x9GZg5PEUB3EC ^"Dwarven Toughness" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "Your Hit Point maximum increases by 1, and it increases by 1 again whenever you gain a level."
            }
            #ti8s6812em8jqYO0fUFbBWYM ^"Stonecunning" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "As a Bonus Action, you gain Tremorsense with a range of 60 feet for 10 minutes. You must be on a stone surface or touching a stone surface to use this Tremorsense. The stone can be natural or worked. You can use this Bonus Action a number of times equal to your Proficiency Bonus, and you regain all expended uses when you finish a Long Rest."
            }
        }
    }
    # source: species (page 84)
    #tlPGdT5DXLk8dchgr9woNIbI ^"Elf" DEF {
        EXTENDS ^"Species"
        PROPERTIES {
            ^"Description" STRING "As an Elf, you have these special traits."
            ^"Creature Type" STRING "Humanoid"
            ^"Size" STRING "Medium (about 5–6 feet tall)"
            ^"Speed" STRING "30 feet"
        }
        FEATURES {
            #tAeMC361ztRZncJHxhUkn5PD ^"Darkvision" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You have Darkvision with a range of 60 feet."
            }
            #tHdWYqZXVzDmIeArHGQKTToc ^"Elven Lineage" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You are part of a lineage that grants you supernatural abilities. Choose a lineage from the Elven Lineages table. You gain the level 1 benefit of that lineage. When you reach character levels 3 and 5, you learn a higher-level spell, as shown on the table. You always have that spell prepared. You can cast it once without a spell slot, and you regain the ability to cast it in that way when you finish a Long Rest. You can also cast the spell using any spell slots you have of the appropriate level. Intelligence, Wisdom, or Charisma is your spellcasting ability for the spells you cast with this trait (choose the ability when you select the lineage)."
                ^"Elven Lineages" DEF {
                    EXTENDS ^"Table"
                    TABLE {
                        COLUMNS ["Lineage", "Level 1", "Level 3", "Level 5"]
                        ROW ["Drow", "The range of your Darkvision increases to 120 feet. You also know the Dancing Lights cantrip.", "Faerie Fire", "Darkness"]
                        ROW ["High Elf", "You know the Prestidigitation cantrip. Whenever you finish a Long Rest, you can replace that cantrip with a different cantrip from the Wizard spell list.", "Detect Magic", "Misty Step"]
                        ROW ["Wood Elf", "Your Speed increases to 35 feet. You also know the Druidcraft cantrip.", "Longstrider", "Pass without Trace"]
                    }
                }
                ^"Options" DEF {
                    ^"Drow" DEF {
                        ^"Level 1"
                        STRING "The range of your Darkvision increases to 120 feet. You also know the Dancing Lights cantrip."
                        ^"Level 3"
                        STRING "Faerie Fire"
                        ^"Level 5"
                        STRING "Darkness"
                    }
                    ^"High Elf" DEF {
                        ^"Level 1"
                        STRING "You know the Prestidigitation cantrip. Whenever you finish a Long Rest, you can replace that cantrip with a different cantrip from the Wizard spell list."
                        ^"Level 3"
                        STRING "Detect Magic"
                        ^"Level 5"
                        STRING "Misty Step"
                    }
                    ^"Wood Elf" DEF {
                        ^"Level 1"
                        STRING "Your Speed increases to 35 feet. You also know the Druidcraft cantrip."
                        ^"Level 3"
                        STRING "Longstrider"
                        ^"Level 5"
                        STRING "Pass without Trace"
                    }
                }
            }
            #tNb5oHitad4CiQoSuAx6naiK ^"Fey Ancestry" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You have Advantage on saving throws you make to avoid or end the Charmed condition."
            }
            #tvHxtbr7aTeG1mYVRP5pcLpu ^"Keen Senses" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You have proficiency in the Insight, Perception, or Survival skill."
            }
            #t6OBjG2Q1crwZchrhSVLNsnu ^"Trance" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You don’t need to sleep, and magic can’t put you to sleep. You can finish a Long Rest in 4 hours if you spend those hours in a trancelike meditation, during which you retain consciousness."
            }
        }
    }
    # source: species (page 85)
    #tMuhhNOQhAnerzxJW7CzzR61 ^"Gnome" DEF {
        EXTENDS ^"Species"
        PROPERTIES {
            ^"Description" STRING "As a Gnome, you have these special traits."
            ^"Creature Type" STRING "Humanoid"
            ^"Size" STRING "Small (about 3–4 feet tall)"
            ^"Speed" STRING "30 feet"
        }
        FEATURES {
            #tTMi7Uv1nZWELVAMoknhAyqO ^"Darkvision" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You have Darkvision with a range of 60 feet."
            }
            #tVftwakrIjBWSFRvXxZvCa77 ^"Gnomish Cunning" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You have Advantage on Intelligence, Wisdom, and Charisma saving throws."
            }
            #tynL7UwMH3iGMh6do5UrUVQh ^"Gnomish Lineage" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You are part of a lineage that grants you supernatural abilities. Choose one of the following options; whichever one you choose, Intelligence, Wisdom, or Charisma is your spellcasting ability for the spells you cast with this trait (choose the ability when you select the lineage):"
                ^"Options" DEF {
                    ^"Forest Gnome"
                    STRING "You know the *Minor Illusion* cantrip. You also always have the *Speak with Animals* spell prepared. You can cast it without a spell slot a number of times equal to your Proficiency Bonus, and you regain all expended uses when you finish a Long Rest. You can also use any spell slots you have to cast the spell."
                    ^"Rock Gnome"
                    STRING "You know the *Mending* and *Prestidigitation* cantrips. In addition, you can spend 10 minutes casting *Prestidigitation* to create a Tiny clockwork device (AC 5, 1 HP), such as a toy, fire starter, or music box. When you create the device, you determine its function by choosing one effect from *Prestidigitation*; the device produces that effect whenever you or another creature takes a Bonus Action to activate it with a touch. If the chosen effect has options within it, you choose one of those options for the device when you create it. For example, if you choose the spell’s ignite-extinguish effect, you determine whether the device ignites or extinguishes fire; the device doesn’t do both. You can have three such devices in existence at a time, and each falls apart 8 hours after its creation or when you dismantle it with a touch as a Utilize action."
                }
            }
        }
    }
    # source: species (page 85)
    #tKjGDKHrrKt7L1Mf5Dj64ZK1 ^"Goliath" DEF {
        EXTENDS ^"Species"
        PROPERTIES {
            ^"Description" STRING "As a Goliath, you have these special traits."
            ^"Creature Type" STRING "Humanoid"
            ^"Size" STRING "Medium (about 7–8 feet tall)"
            ^"Speed" STRING "35 feet"
        }
        FEATURES {
            #tVcGEnvYqZ3t7SmPAmhNjbV3 ^"Giant Ancestry" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You are descended from Giants. Choose one of the following benefits—a supernatural boon from your ancestry; you can use the chosen benefit a number of times equal to your Proficiency Bonus, and you regain all expended uses when you finish a Long Rest:"
                ^"Options" DEF {
                    ^"Cloud’s Jaunt (Cloud Giant)"
                    STRING "As a Bonus Action, you magically teleport up to 30 feet to an unoccupied space you can see."
                    ^"Fire’s Burn (Fire Giant)"
                    STRING "When you hit a target with an attack roll and deal damage to it, you can also deal 1d10 Fire damage to that target."
                    ^"Frost’s Chill (Frost Giant)"
                    STRING "When you hit a target with an attack roll and deal damage to it, you can also deal 1d6 Cold damage to that target and reduce its Speed by 10 feet until the start of your next turn."
                    ^"Hill’s Tumble (Hill Giant)"
                    STRING "When you hit a Large or smaller creature with an attack roll and deal damage to it, you can give that target the Prone condition."
                    ^"Stone’s Endurance (Stone Giant)"
                    STRING "When you take damage, you can take a Reaction to roll 1d12. Add your Constitution modifier to the number rolled and reduce the damage by that total."
                    ^"Storm’s Thunder (Storm Giant)"
                    STRING "When you take damage from a creature within 60 feet of you, you can take a Reaction to deal 1d8 Thunder damage to that creature."
                }
            }
            #tMIzzeqblBzNWgroL5jFOyu3 ^"Large Form" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "Starting at character level 5, you can change your size to Large as a Bonus Action if you’re in a big enough space. This transformation lasts for 10 minutes or until you end it (no action required). For that duration, you have Advantage on Strength checks, and your Speed increases by 10 feet. Once you use this trait, you can’t use it again until you finish a Long Rest."
            }
            #tgx5fxOU2g47Ev64jy1MawUs ^"Powerful Build" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You have Advantage on any ability check you make to end the Grappled condition. You also count as one size larger when determining your carrying capacity."
            }
        }
    }
