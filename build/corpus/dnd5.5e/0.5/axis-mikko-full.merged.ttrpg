    #tRKAmk0GXVw2InfTWksVbv2G ^"Arcane Focus" DEF {
        EXTENDS ^"Adventuring Gear"
        PROPERTIES {
            ^"Category" STRING "Adventuring Gear"
            ^"Cost" DEF {
                ^"Varies" BOOLEAN true
            }
            ^"Weight" STRING "Varies"
            ^"Description" STRING "An Arcane Focus takes one of the forms in the Arcane Focuses table and is bejeweled or carved to channel arcane magic. A Sorcerer, Warlock, or Wizard can use such an item as a Spellcasting Focus."
            ^"Arcane Focuses" DEF {
                EXTENDS ^"Table"
                TABLE {
