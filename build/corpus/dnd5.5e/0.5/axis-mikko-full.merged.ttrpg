    #tx6aIL0H2Ko0UNsubmLmhtdf ^"Armor of Invulnerability" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Armor (Plate Armor)"
            ^"Rarity" STRING "Legendary"
