    # source: spell (page 132)
    #ti1nic2QdHCFbEoGABOFyJsT ^"Fire Shield" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 4
            ^"School" STRING "Evocation"
