    # ============= Spirit Tamer (Ranger) =============
    #tQEiD7oLJiZhXZmi3LjcMo8 ^"Spirit Tamer" DEF {
        EXTENDS ^"Subclass"
        PROPERTIES {
            ^"Parent Class" STRING "Ranger"
            ^"Tagline" STRING "Call on the Wyld to Defend your Pack"
            ^"Description" STRING "Rangers who follow the path of the Spirit Tamer learn to capture the essence of creatures and summon their spirits as allies. Drawing on the magic of the natural world, a Spirit Tamer can call forth creatures both mundane and magical, bending the boundary between the material and spirit realms."
        }
        FEATURES {
            #t6HhYkfRMxVdIHXss78cGlv ^"Level 3: Spirit Taming" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 3
                ^"Description"
                STRING "Your connection to the spirit world allows you to replicate the essence of creatures for a brief time."
                # The feature's two named parts are printed as their own headed passages.
                ^"Spirit Charge" DEF {
                    ^"Description"
                    STRING "As a Bonus Action, you can target one creature you can see within 60 feet of you whose Challenge Rating does not exceed your Ranger level + your Proficiency Bonus. The target must make a Wisdom saving throw against your spell save DC. A creature can choose to fail this saving throw.

• Failure: You gain a Spirit Charge from that creature.

• Success: You do not gain a Spirit Charge, but you learn whether the creature has any damage resistances, immunities, or vulnerabilities and what they are.

Once you gain a Spirit Charge from a creature, you can’t gain another Spirit Charge from that creature until you expend the current one. When you expend a Spirit Charge, it is lost.

You can have a number of unexpended Spirit Charges equal to your Proficiency Bonus. If you gain a Spirit Charge while at this limit, you must choose one of your existing Spirit Charges to lose.

Spirit Charges are stored numerous ways by Spirit Tamers. Potential options include totems, arrows, rocks, and other baubles.

The GM determines whether a creature is eligible to be Spirit Tamed."
                    ^"Action Type"
                    STRING "Bonus Action"
                    ^"Range"
                    INTEGER 60
                    ^"Maximum Challenge Rating"
                    STRING "your Ranger level + your Proficiency Bonus"
                    ^"Save" DEF {
                        ^"Ability"
                        STRING "Wisdom"
                        ^"DC"
                        STRING "your spell save DC"
                    }
                    ^"Maximum Charges"
                    STRING "your Proficiency Bonus"
                }
                ^"Spirit Summon" DEF {
                    ^"Description"
                    STRING "As a Bonus Action, you can expend a Spirit Charge to summon the spirit of the charged creature at a point you can see within 60 feet. The spirit lasts until the start of your next turn. The spirit takes its turn immediately after yours. On its turn, the spirit can move and take actions as normal, following the verbal commands you issue as part of the Bonus Action used to summon it. No additional action is required to command it.

The spirit uses the creature’s stat block with the following exceptions:"
                    ^"Stat Block Exceptions"
                    LIST OF STRING [
                        "The spirit has no legendary actions or Legendary Resistance.",
                        "The spirit can’t use lair actions and doesn’t create regional effects.",
                        "The spirit can’t summon other creatures or create creatures that persist beyond its duration.",
                        "If the spirit has an ability that recharges after a die roll, such as Recharge 5–6, you roll for that recharge immediately when the spirit is summoned and again on following turns. The spirit can use that ability during its duration only if the recharge roll succeeds.",
                        "If the spirit can cast spells, it can cast spells of 5th level or lower, and it can’t cast any spell that requires a material component."
                    ]
                    ^"Magical Effect"
                    STRING "The summoned spirit is a magical effect. It ends early if you lose concentration, if it enters an antimagic field, or if it is successfully targeted by dispel magic. For the purposes of dispel magic, the spirit is treated as a spell of a level equal to the highest-level spell slot you can cast."
                    ^"Action Type"
                    STRING "Bonus Action"
                    ^"Range"
                    INTEGER 60
                    ^"Duration"
                    STRING "until the start of your next turn"
                    ^"Maximum Spell Level Cast by Spirit"
                    INTEGER 5
                }
            }
            #tdEEp1TRk5fzyspAh3sQYRt ^"Level 3: Spirit Tamer Spells" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 3
                ^"Description"
                STRING "You always have the following spells prepared, and they don’t count against the number of Ranger spells you have prepared."
                ^"Granted Spells" DEF {
                    ^"Level 3"
                    LIST OF STRING ["Command"]
                    ^"Level 5"
                    LIST OF STRING ["Detect Thoughts"]
                    ^"Level 9"
                    LIST OF STRING ["Conjure Animals"]
                    ^"Level 13"
                    LIST OF STRING ["Conjure Woodland Beings"]
                    ^"Level 17"
                    LIST OF STRING ["Commune with Nature"]
                }
                ^"Spirit Tamer Spells" DEF {
                    EXTENDS ^"Table"
                    TABLE {
                        COLUMNS ["Ranger Level", "Spells"]
                        ROW ["3", "Command"]
                        ROW ["5", "Detect Thoughts"]
                        ROW ["9", "Conjure Animals"]
                        ROW ["13", "Conjure Woodland Beings"]
                        ROW ["17", "Commune with Nature"]
                    }
                }
            }
            #tt54U4Ya7NPV44vrow3PeHW ^"Level 3: Essence Hunter" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 3
                ^"Description"
                STRING "You have honed your senses to track targets and detect spirits. You gain proficiency in the Perception and Survival skills if you do not already have it. Your Proficiency Bonus is doubled for any ability check you make that uses either of those proficiencies."
                ^"Skill Proficiencies"
                LIST OF STRING ["Perception", "Survival"]
                ^"Expertise"
                LIST OF STRING ["Perception", "Survival"]
            }
            #tRjo3k1xAlqKGJfRZ4x7F5r ^"Level 7: Spirit Resonance" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 7
                ^"Description"
                STRING "You can attune yourself to certain spirits, ensuring their essence is always within reach. Choose three creatures from which you have previously gained Spirit Charges. Each chosen creature must have a Challenge Rating no higher than your Proficiency Bonus.

You always have one Spirit Charge available for each of these creatures. When you expend one of these Spirit Charges, you can’t use that creature again in this way until you finish a Short or Long Rest.

During a Long Rest, you can perform a 1-hour ritual to replace any current spirit resonances with different eligible creatures."
                ^"Attuned Creatures"
                INTEGER 3
                ^"Maximum Challenge Rating"
                STRING "your Proficiency Bonus"
                ^"Recharge"
                STRING "Short or Long Rest"
            }
            #tgK6fcEpVeUa1e8Wsxsup0X ^"Level 11: Spirit Sustain" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 11
                ^"Description"
                STRING "When you use Spirit Summon, you can spend a spell slot of 1st-level or higher at the start of each of your turns to sustain the spirit for another turn."
                ^"Minimum Spell Slot Level"
                INTEGER 1
            }
            #tHuAregLs7ZxoTIUPtEwbmU ^"Level 15: Spirit Search" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 15
                # The printed feature ends without a full stop ("…until you finish a Long Rest"); kept as printed.
                ^"Description"
                STRING "As an Action, you attune your senses to the spirit world for 10 minutes. During this time, you become aware of creatures within 1 mile of you that are eligible to be Spirit Tamed. You only recognize spirits of species you have previously Spirit Tamed and learn their approximate direction and distance.

While this feature is active, you can attempt to gain a Spirit Charge from any recognized creature, even if you do not have line of sight to it. The creature must still make a Wisdom saving throw against your spell save DC as normal.

This feature cannot detect creatures through lead, magical barriers, or effects that block divination or spiritual detection.

Once you use this feature, you can’t use it again until you finish a Long Rest"
                ^"Action Type"
                STRING "Action"
                ^"Duration"
                STRING "10 minutes"
                ^"Range"
                STRING "1 mile"
                ^"Recharge"
                STRING "Long Rest"
            }
        }
    }
    # Source: The Axis Saga - Freebie Preview (Wyldwolf Games), pages 14-15.
    # Both items EXTEND the SRD ^"Magic Item" (Item Type / Rarity / attunement /
    # Description); their named properties are ^"Item Property" DEFs in FEATURES.
    #tYq8BwWsMrhPSEjBF8mG2Fw ^"Trepidation" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Weapon (handcannon)"
            ^"Rarity" STRING "Legendary"
            ^"Requires Attunement" BOOLEAN true
            ^"Attunement Requirement" STRING "by a Reclaimer"
            ^"Description" STRING "Used for over a century by the Reclaimer Ari, Trepidation was named for its wielder’s constant readiness and reflects a portion of his quick-minded certainty. While you are attuned to Trepidation as a Reclaimer, you gain a +3 bonus to attack rolls and damage rolls made with this magic weapon and the weapon has the following additional properties:"
            ^"Attack Bonus" INTEGER 3
            ^"Damage Bonus" INTEGER 3
            ^"Ammunition" STRING "Ignition Dust Cartridges"
            ^"Capacity" INTEGER 6
        }
        FEATURES {
            #t7zK4sHPLEimjk4PadJzZzq ^"Quick as a Flash" DEF {
                EXTENDS ^"Item Property"
                ^"Description"
                STRING "You have Advantage on Initiative rolls, and you can’t be Surprised.

Once per Long Rest, you can take a Bonus Action to flourish Trepidation and cast Haste on yourself. The spell doesn’t require Concentration when cast in this way. When the spell ends, you don’t suffer lethargy."
                ^"Spell"
                STRING "Haste"
                ^"Action Type"
                STRING "Bonus Action"
                ^"Recharge"
                STRING "Long Rest"
            }
            #tkb3r9mzjjM5kmC45SBKgcV ^"Mercurial Grace" DEF {
                EXTENDS ^"Item Property"
                ^"Description"
                STRING "Being within 5 feet of a hostile creature doesn’t impose Disadvantage on your ranged attack rolls with Trepidation."
            }
            #thsX4joash3JDN961pkyizn ^"Fan the Hammer" DEF {
                EXTENDS ^"Item Property"
                ^"Description"
                STRING "When Trepidation has 6 Ignition Dust Cartridges loaded, you can take an Action to unleash all six shots in rapid succession. Make six separate ranged attacks with Trepidation against creatures of your choice within the weapon’s range. These attack rolls can’t have Advantage for any reason. On a hit, a target takes the weapon’s normal damage plus an extra 2d6 Force damage.If a creature is hit by two or more of these attacks, it must succeed on a DC 18 Strength saving throw or be knocked Prone.

Immediately after you use this property, Trepidation becomes a +1 weapon and loses all other properties except Ammunition, Reload, and its damage profile. This suppression lasts until the next dawn."
                ^"Action Type"
                STRING "Action"
                ^"Attacks"
                INTEGER 6
                ^"Extra Damage" DEF {
                    ^"Dice"
                    STRING "2d6"
                    ^"Type"
                    STRING "Force"
                }
                ^"Save" DEF {
                    ^"Ability"
                    STRING "Strength"
                    ^"DC"
                    INTEGER 18
                }
                ^"Suppressed Bonus"
                INTEGER 1
                ^"Suppression Ends"
                STRING "the next dawn"
            }
        }
        GUIDANCE {
            ENTRY ^"In the Full Release" #tLagP1kKfzNdb496ZiKGV7W {
                CONCERNS [#tYq8BwWsMrhPSEjBF8mG2Fw ^"Trepidation"]
                TOPICS ["preview", "full release"]
                TEXT "In the Full Release: Discover more weapons of the Reclaimers, including other unique Handcannons, and other tools for you to discover."
            }
        }
    }
    #thSJFE0stglZmh80vVzVu4S ^"Pressure" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Weapon (longsword)"
            ^"Rarity" STRING "Legendary"
            ^"Requires Attunement" BOOLEAN true
            ^"Description" STRING "Forged from a shard of the Mourning Maiden’s sword after she slew the Nameless One, Pressure carries but a pale echo of the power she wielded when she claimed dominion over Death itself.

You gain a +2 bonus to attack rolls and damage rolls made with this magic weapon and it deals an additional 1d8 Necrotic damage."
            ^"Attack Bonus" INTEGER 2
            ^"Damage Bonus" INTEGER 2
            ^"Extra Damage" DEF {
                ^"Dice" STRING "1d8"
                ^"Type" STRING "Necrotic"
            }
        }
        FEATURES {
            #tn6zDx23aahR7LhWBanaigD ^"Covenant of Pressure" DEF {
                EXTENDS ^"Item Property"
                # "Your maximum hit points remain reduced until your Covenant ends" is printed without a full stop.
                ^"Description"
                STRING "While attuned to Pressure, you may invoke its Covenant as a Bonus Action.

When you do, reduce your maximum hit points by half. Round down to the nearest whole number. You gain an equal number of Covenant Hit Points. Covenant Hit Points are distinct from Temporary Hit Points. They stack with Temporary Hit Points, are lost before your normal hit points, and cannot be restored unless a feature specifically restores Covenant Hit Points.

Your maximum hit points remain reduced until your Covenant ends

The Covenant of Pressure ends if you are separated from the blade for 1 minute or if you end it early by spending a Bonus Action. When your Covenant ends, your maximum hit points immediately return to normal. If your current hit points exceed your restored maximum, they are reduced to your restored maximum."
                ^"Action Type"
                STRING "Bonus Action"
                ^"Separation Limit"
                STRING "1 minute"
            }
        }
        GUIDANCE {
            ENTRY ^"In the Full Release" #tkbLkUzpIjuui4cx6FmPX8k {
                CONCERNS [#thSJFE0stglZmh80vVzVu4S ^"Pressure"]
                TOPICS ["preview", "full release"]
                TEXT "In the Full Release: Discover Pressure’s complete legendary progression, additional Covenant abilities, Covenant Spells, and the story of the Mourning Maiden’s final battle against the Nameless One."
            }
        }
    }
    # Source: The Axis Saga - Freebie Preview (Wyldwolf Games), pages 8-9.
    # Page 9 (the four tables) is an image with no text layer in the PDF; the tables
    # were transcribed from the page render. Everything else is the page-8 text layer.
    # The generator modifies the SRD ^"Cultist" stat block (Dnd5_5e_Monsters), which
    # is referenced, never copied.
    #tP1efy8AaItMMaN1fN4Uoxg ^"Cultists of the Great Silence" DEF {
        DESCRIPTION "Not every servant of Kryphos was born to darkness. Many were once farmers, soldiers, scholars, artisans, or leaders before the Silence hollowed them out. Though their loyalty now belongs to the Great Silence, fragments of their former lives remain. When creating a Cultist of the Silence, roll or choose from the tables below to reflect who the creature once was.

These traits modify the base cultist stat block and help ensure that no two servants of Kryphos fight exactly the same way. A cultist usually gains one Past Life trait and one Silence Mutation."
        PROPERTIES {
            ^"Base Stat Block" STRING "Cultist"
            ^"Usual Past Life Traits" INTEGER 1
            ^"Usual Silence Mutations" INTEGER 1
        }
        RULES {
        }
        RULE ^"Actions" {
            DESCRIPTION "Cultists add the rolled/chosen Action to their stat-block to be used normally."
        }
    }
    GUIDANCE {
        ENTRY ^"Design Intent" #tazKvBURo1ayVRl3Wc6GBMc {
            CONCERNS [#tP1efy8AaItMMaN1fN4Uoxg ^"Cultists of the Great Silence"]
            TOPICS ["design intent", "cultist generation"]
            TEXT "Cultists of the Silence are not uniform soldiers. They are people who were worn down. Fragments of their former identities remain, twisted by the interference of Kryphos.

This system allows a Game Master to quickly generate unique cultists without building new stat blocks. No two servants of the Great Silence need be the same."
        }
        ENTRY ^"In the Full Release" #tvkO33ob80kKH6hcopsGfqn {
            CONCERNS [#tP1efy8AaItMMaN1fN4Uoxg ^"Cultists of the Great Silence"]
            TOPICS ["preview", "full release"]
            TEXT "In the Full Release: Generate countless unique servants of Kryphos with expanded traits, mutations, variants, and adventure hooks.

With our Silent Template, you can modify any creature in any sourcebook: dragons, giants, aberrations; anything can succumb to the Silence!"
        }
    }
