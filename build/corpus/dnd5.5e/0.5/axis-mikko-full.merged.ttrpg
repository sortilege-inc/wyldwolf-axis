    # source: magic item (page 209)
    #tbMRpP67kXGvA7Sq5qR7AomU ^"Adamantine Armor" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Armor (Any Medium or Heavy, Except Hide Armor)"
            ^"Rarity" STRING "Uncommon"
            ^"Description" STRING "This suit of armor is reinforced with adamantine, one of the hardest substances in existence. While you're wearing it, any Critical Hit against you becomes a normal hit."
        }
    }
    # source: magic item (page 209)
    #tMXJpACZdEEIEcf6joBA5f7S ^"Ammunition, +1, +2, or +3" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Weapon (Any Ammunition)"
            ^"Rarity" STRING "Uncommon (+1), Rare (+2), or Very Rare (+3)"
            ^"Description" STRING "You have a bonus to attack rolls and damage rolls made with this piece of magic ammunition. The bonus is determined by the rarity of the ammunition. Once it hits a target, the ammunition is no longer magical. This ammunition is typically found or sold in quantities of ten or twenty pieces. Ten pieces of this ammunition are equivalent in value to a potion of the same rarity."
        }
    }
    # source: magic item (page 209)
    #tEZAmCqekj37QMpLuyD6rnNK ^"Ammunition of Slaying" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Weapon (Any Ammunition)"
            ^"Rarity" STRING "Very Rare"
            ^"Description" STRING "This magic ammunition is meant to slay creatures of a particular type, which the GM chooses or determines randomly by rolling on the table below. If a creature of that type takes damage from the ammunition, the creature makes a DC 17 Constitution saving throw, taking an extra 6d10 Force damage on a failed save or half as much extra damage on a successful one. After dealing its extra damage to a creature, the ammunition becomes nonmagical."
            ^"1d100 / Creature Type" DEF {
                EXTENDS ^"Table"
                TABLE {
                COLUMNS ["1d100", "Creature Type"]
                ROW ["01–10", "Aberrations"]
                ROW ["11–15", "Beasts"]
                ROW ["16–20", "Celestials"]
                ROW ["21–25", "Constructs"]
                ROW ["26–35", "Dragons"]
                ROW ["36–45", "Elementals"]
                ROW ["46–50", "Humanoids"]
                ROW ["51–60", "Fey"]
                ROW ["61–70", "Fiends"]
                ROW ["71–75", "Giants"]
                ROW ["76–80", "Monstrosities"]
                ROW ["81–85", "Oozes"]
                ROW ["86–90", "Plants"]
                ROW ["91–00", "Undead"]
            }
            }
        }
    }
    # source: magic item (page 209)
    #tVC0iOLSMui848cYJeAeAtZk ^"Amulet of Health" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Wondrous Item"
            ^"Rarity" STRING "Rare"
            ^"Requires Attunement" BOOLEAN true
            ^"Description" STRING "Your Constitution is 19 while you wear this amulet. It has no effect on you if your Constitution is 19 or higher without it."
        }
    }
    # source: magic item (page 209)
    #tHHLroL21FeIol8tfy3Q7tMD ^"Amulet of Proof against Detection and Location" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Wondrous Item"
            ^"Rarity" STRING "Uncommon"
            ^"Requires Attunement" BOOLEAN true
            ^"Description" STRING "While wearing this amulet, you can't be targeted by Divination spells or perceived through magical scrying sensors unless you allow it."
        }
    }
    # source: magic item (page 209)
    #t1kpoJ2kx1EpWKCw5wuyQV94 ^"Amulet of the Planes" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Wondrous Item"
            ^"Rarity" STRING "Very Rare"
            ^"Requires Attunement" BOOLEAN true
            ^"Description" STRING "While wearing this amulet, you can take a Magic action to name a location that you are familiar with on another plane of existence. Then make a DC 15 Intelligence (Arcana) check. On a successful check, you cast Plane Shift. On a failed check, you and each creature and object within 15 feet of you travel to a random destination determined by rolling 1d100 and consulting the following table."
            ^"1d100 / Destination" DEF {
                EXTENDS ^"Table"
                TABLE {
                COLUMNS ["1d100", "Destination"]
                ROW ["01–60", "Random location on the plane you named"]
                ROW ["61–70", "Random location on an Inner Plane determined by rolling 1d6: on a 1, the Plane of Air; on a 2, the Plane of Earth; on a 3, the Plane of Fire; on a 4, the Plane of Water; on a 5, the Feywild; on a 6, the Shadowfell"]
                ROW ["71–80", "Random location on an Outer Plane determined by rolling 1d8: on a 1, Arborea; on a 2, Arcadia; on a 3, the Beastlands; on a 4, Bytopia; on a 5, Elysium; on a 6, Mechanus; on a 7, Mount Celestia; on an 8, Ysgard"]
                ROW ["81–90", "Random location on an Outer Plane determined by rolling 1d8: on a 1, the Abyss; on a 2, Acheron; on a 3, Carceri; on a 4, Gehenna; on a 5, Hades; on a 6, Limbo; on a 7, the Nine Hells; on an 8, Pandemonium"]
                ROW ["91–00", "Random location on the Astral Plane"]
            }
            }
        }
    }
    # source: magic item (page 209)
    #tUOWAoNpLb5nfu4SNT5TCwPO ^"Animated Shield" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Armor (Shield)"
            ^"Rarity" STRING "Very Rare"
            ^"Requires Attunement" BOOLEAN true
            ^"Description" STRING "While holding this Shield, you can take a Bonus Action to cause it to animate. The Shield leaps into the air and hovers in your space to protect you as if you were wielding it, leaving your hands free. The Shield remains animate for 1 minute, until you take a Bonus Action to end this effect, or until you die or have the Incapacitated condition, at which point the Shield falls to the ground or into your hand if you have one free."
        }
    }
    # source: magic item (page 210)
    #ts3qSPV81KWyTGKuxCyKfHrc ^"Apparatus of the Crab" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Wondrous Item"
            ^"Rarity" STRING "Legendary"
            ^"Description" STRING "This item first appears to be a sealed iron barrel weighing 500 pounds. The barrel has a hidden catch, which can be found with a successful DC 20 Intelligence (Investigation) check. Releasing the catch unlocks a hatch at one end of the barrel, allowing two Medium or smaller creatures to crawl inside. Ten levers are set in a row at the far end, each in a neutral position, able to move up or down. When certain levers are used, the apparatus transforms to resemble a giant lobster. The Apparatus of the Crab is a Large object with the following statistics: AC 20; HP 200; Speed 30 ft., Swim 30 ft. (or 0 ft. for both if the legs aren't extended); Immunity to Poison and Psychic damage. To be used as a vehicle, the apparatus requires one pilot. While the apparatus's hatch is closed, the compartment is airtight and watertight. The compartment holds enough air for 10 hours of breathing, divided by the number of breathing creatures inside. The apparatus floats on water. It can also go underwater to a depth of 900 feet. Below that, the vehicle takes 2d6 Bludgeoning damage each minute from pressure. A creature in the compartment can take a Utilize action to move as many as two of the apparatus's levers up or down. After each use, a lever goes back to its neutral position. Each lever, from left to right, functions as shown in the Apparatus of the Crab Levers table."
            ^"Apparatus of the Crab Levers" DEF {
                EXTENDS ^"Table"
                TABLE {
                COLUMNS ["Lever", "Up", "Down"]
                ROW ["1", "Legs extend, allowing the apparatus to walk and swim.", "Legs retract, reducing the apparatus’s Speed and Swim Speed to 0 and making it unable to benefit from bonuses to speed."]
                ROW ["2", "Forward window shutter opens.", "Forward window shutter closes."]
                ROW ["3", "Side window shutters open (two per side).", "Side window shutters close (two per side)."]
                ROW ["4", "Two claws extend from the front side of the apparatus.", "The claws retract."]
                ROW ["5", "Each extended claw makes the following melee attack: +8 to hit, reach 5 ft. Hit: 7 (2d6) Bludgeoning damage.", "Each extended claw makes the following melee attack: +8 to hit, reach 5 ft. Hit: The target has the Grappled condition (escape DC 15)."]
                ROW ["6", "The apparatus walks or swims forward provided its legs are extended.", "The apparatus walks or swims backward provided its legs are extended."]
                ROW ["7", "The apparatus turns 90 degrees counterclockwise provided its legs are extended.", "The apparatus turns 90 degrees clockwise provided its legs are extended."]
                ROW ["8", "Eyelike fixtures emit Bright Light in a 30-foot radius and Dim Light for an additional 30 feet.", "The light turns off."]
                ROW ["9", "The apparatus sinks up to 20 feet if it’s in liquid.", "The apparatus rises up to 20 feet if it’s in liquid."]
                ROW ["10", "The rear hatch unseals and opens.", "The rear hatch closes and seals."]
            }
            }
        }
    }
