                ROW ["Hold Monster", "5"]
                ROW ["Hold Person", "2"]
            }
            }
        }
    }
    # source: magic item (page 250)
    #tsvOSMa8O7BKOk4cFil4zLRk ^"Wand of Enemy Detection" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Wand"
            ^"Rarity" STRING "Rare"
            ^"Requires Attunement" BOOLEAN true
