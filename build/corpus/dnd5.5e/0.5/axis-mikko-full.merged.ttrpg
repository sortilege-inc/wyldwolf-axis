            ^"Duration" STRING "1 round"
            ^"Description" STRING "You point toward a creature within range and whisper a message. The target (and only the target) hears the message and can reply in a whisper that only you can hear. You can cast this spell through solid objects if you are familiar with the target and know it is beyond the barrier. Magical silence; 1 foot of stone, metal, or wood; or a thin sheet of lead blocks the spell."
            ^"Classes" LIST OF STRING ["Bard", "Druid", "Sorcerer", "Wizard"]
        }
    }
    # source: spell (page 149)
    #teBWQB4MYQpUaCyUg8fGTEVC ^"Meteor Swarm" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 9
            ^"School" STRING "Evocation"
            ^"Casting Time" STRING "Action"
            ^"Range" STRING "1 mile"
            ^"Components" STRING "V, S"
            ^"Duration" STRING "Instantaneous"
            ^"Description" STRING "Blazing orbs of fire plummet to the ground at four different points you can see within range. Each creature in a 40-foot-radius Sphere centered on each of those points makes a Dexterity saving throw. A creature takes 20d6 Fire damage and 20d6 Bludgeoning damage on a failed save or half as much damage on a successful one. A creature in the area of more than one fiery Sphere is affected only once. A nonmagical object that isn’t being worn or carried also takes the damage if it’s in the spell’s area, and the object starts burning if it’s flammable."
            ^"Classes" LIST OF STRING ["Sorcerer", "Wizard"]
        }
    }
    # source: spell (page 149)
