            ^"Classes" LIST OF STRING ["Bard", "Druid"]
        }
    }
    # source: spell (page 129)
    #tTh2bCMXwFqGtqBndXYujDGe ^"Faithful Hound" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 4
            ^"School" STRING "Conjuration"
            ^"Casting Time" STRING "Action"
            ^"Range" STRING "30 feet"
