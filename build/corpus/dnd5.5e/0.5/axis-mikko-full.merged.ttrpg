            ^"Spellcasting Ability" STRING "Wisdom"
            ^"Starting Equipment" DEF {
                ^"Option A" LIST OF STRING ["Studded Leather Armor", "Scimitar", "Shortsword", "Longbow", "20 Arrows", "Quiver", "Druidic Focus (sprig of mistletoe)", "Explorer's Pack", "7 GP"]
