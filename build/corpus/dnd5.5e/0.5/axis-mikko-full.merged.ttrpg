                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You can take the Dash action as a Bonus Action. When you do so, you gain a number of Temporary Hit Points equal to your Proficiency Bonus. You can use this trait a number of times equal to your Proficiency Bonus, and you regain all expended uses when you finish a Short or Long Rest."
            }
            #takKN31peolZino0WzZgEpKb ^"Darkvision" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You have Darkvision with a range of 120 feet."
            }
            #tPaNTA36Xd7fLlDZdZUbhHOw ^"Relentless Endurance" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "When you are reduced to 0 Hit Points but not killed outright, you can drop to 1 Hit Point instead. Once you use this trait, you can’t do so again until you finish a Long Rest."
            }
        }
    }
    # source: species (page 86)
    #toOZFWGS1FMdOoRzoxLaFTnK ^"Tiefling" DEF {
        EXTENDS ^"Species"
        PROPERTIES {
            ^"Description" STRING "As a Tiefling, you have the following special traits."
            ^"Creature Type" STRING "Humanoid"
            ^"Size" STRING "Medium (about 4–7 feet tall) or Small (about 3–4 feet tall), chosen when you select this species"
            ^"Speed" STRING "30 feet"
        }
        FEATURES {
            #trki69FL5uK6ADdvXzmAEhSO ^"Darkvision" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You have Darkvision with a range of 60 feet."
            }
            #tTBcb3cqm3tUEvv1ioZXuhuC ^"Fiendish Legacy" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You are the recipient of a legacy that grants you supernatural abilities. Choose a legacy from the Fiendish Legacies table. You gain the level 1 benefit of the chosen legacy. When you reach character levels 3 and 5, you learn a higher-level spell, as shown on the table. You always have that spell prepared. You can cast it once without a spell slot, and you regain the ability to cast it in that way when you finish a Long Rest. You can also cast the spell using any spell slots you have of the appropriate level. Intelligence, Wisdom, or Charisma is your spellcasting ability for the spells you cast with this trait (choose the ability when you select the legacy)."
                ^"Fiendish Legacies" DEF {
                    EXTENDS ^"Table"
                    TABLE {
                        COLUMNS ["Legacy", "Level 1", "Level 3", "Level 5"]
                        ROW ["Abyssal", "You have Resistance to Poison damage. You also know the Poison Spray cantrip.", "Ray of Sickness", "Hold Person"]
                        ROW ["Chthonic", "You have Resistance to Necrotic damage. You also know the Chill Touch cantrip.", "False Life", "Ray of Enfeeblement"]
                        ROW ["Infernal", "You have Resistance to Fire damage. You also know the Fire Bolt cantrip.", "Hellish Rebuke", "Darkness"]
                    }
                }
                ^"Options" DEF {
                    ^"Abyssal" DEF {
                        ^"Level 1"
                        STRING "You have Resistance to Poison damage. You also know the Poison Spray cantrip."
                        ^"Level 3"
                        STRING "Ray of Sickness"
                        ^"Level 5"
                        STRING "Hold Person"
                    }
                    ^"Chthonic" DEF {
                        ^"Level 1"
                        STRING "You have Resistance to Necrotic damage. You also know the Chill Touch cantrip."
                        ^"Level 3"
                        STRING "False Life"
                        ^"Level 5"
                        STRING "Ray of Enfeeblement"
                    }
                    ^"Infernal" DEF {
                        ^"Level 1"
                        STRING "You have Resistance to Fire damage. You also know the Fire Bolt cantrip."
                        ^"Level 3"
                        STRING "Hellish Rebuke"
                        ^"Level 5"
                        STRING "Darkness"
                    }
                }
            }
            #t66TliiOeWvUR607yYKuo48l ^"Otherworldly Presence" DEF {
                EXTENDS ^"Species Trait"
                ^"Description"
                STRING "You know the *Thaumaturgy* cantrip. When you cast it with this trait, the spell uses the same spellcasting ability you use for your Fiendish Legacy trait."
            }
        }
    }
