    # ---- Actions (d6) ----
    # Each rolled action is a ^"Stat Block Feature" (Category "Action"), the same
    # shape the SRD monsters use, so it drops straight into the Cultist's FEATURES.
    #tkjhmyA2F3bCmw9NKYrvZfT ^"Actions" DEF {
        EXTENDS ^"Table"
        TABLE {
            COLUMNS ["d6", "Action", "Effect"]
            ROW ["1", "Dissonant Club", "Melee Weapon Attack: +3 to hit, reach 5 ft., one target. Hit: 4 (1d6+1) Bludgeoning damage, 9 (2d8) Psychic damage, and the target must make a DC 12 Charisma saving throw or become cursed with The Great Silence."]
            ROW ["2", "Cruel Knife", "Melee Weapon Attack: +3 to hit, reach 5 ft., one target. Hit: 3 (1d4+1) Slashing damage, 13 (3d8) Poison damage, and the target must make a DC 12 Constitution saving throw or become Poisoned for 1 hour. While Poisoned in this way, the target cannot regain Hit Points."]
            ROW ["3", "Dread Whisper", "Cantrip spellcasting."]
            ROW ["4", "Painful Lash", "Melee Weapon Attack: +3 to hit, reach 10 ft., one target. Hit: 3 (1d4+1) Slashing damage, 9 (2d8) Necrotic damage, and the target must make a DC 12 Constitution saving throw or become Wounded for 1 minute. While Wounded in this way, the target loses 1d4 hit points at the start of their turn."]
            ROW ["5", "Void Step", "The cultist teleports up to 15 feet to an unoccupied space it can see. Then each creature within 5 feet of the space that the cultist left must succeed a DC 12 Dexterity saving throw or take 1d6 Necrotic damage."]
            ROW ["6", "Shushing Touch", "Touch a creature to give them the silenced condition."]
        }
    }
