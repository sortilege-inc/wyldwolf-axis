    # source: SRD 5.2.1 Classes (pages 28-82)
    # source: class (pages 28-31)
    #t1e7ZS645ZyWzj0SZd2lJLK1 ^"Barbarian" DEF {
        EXTENDS ^"Class"
        PROPERTIES {
            ^"Description" STRING
            ^"Primary Ability" STRING "Strength"
            ^"Hit Point Die" STRING "D12 per Barbarian level"
            ^"Saving Throw Proficiencies" LIST OF STRING ["Strength", "Constitution"]
            ^"Armor Training" LIST OF STRING ["Light", "Medium", "Shields"]
            ^"Weapon Proficiencies" LIST OF STRING ["Simple", "Martial"]
            ^"Weapon Mastery Count" INTEGER 2
            ^"Skill Choices" DEF {
                ^"Count" INTEGER 2
                ^"Options" LIST OF STRING ["Animal Handling", "Athletics", "Intimidation", "Nature", "Perception", "Survival"]
            }
            ^"Starting Equipment" DEF {
                ^"Option A" LIST OF STRING ["Greataxe", "4 Handaxes", "Explorer's Pack", "15 GP"]
                ^"Option B" STRING "75 GP"
            }
            ^"Progression" DEF {
                ^"Level 1" DEF {
                    ^"Proficiency Bonus" INTEGER 2
                    ^"Class Features" LIST OF STRING ["Rage", "Unarmored Defense", "Weapon Mastery"]
                    ^"Rages" INTEGER 2
                    ^"Rage Damage" INTEGER 2
                    ^"Weapon Mastery" INTEGER 2
                }
                ^"Level 2" DEF {
                    ^"Proficiency Bonus" INTEGER 2
                    ^"Class Features" LIST OF STRING ["Danger Sense", "Reckless Attack"]
                    ^"Rages" INTEGER 2
                    ^"Rage Damage" INTEGER 2
                    ^"Weapon Mastery" INTEGER 2
                }
                ^"Level 3" DEF {
                    ^"Proficiency Bonus" INTEGER 2
                    ^"Class Features" LIST OF STRING ["Barbarian Subclass", "Primal Knowledge"]
                    ^"Rages" INTEGER 3
                    ^"Rage Damage" INTEGER 2
                    ^"Weapon Mastery" INTEGER 2
                }
                ^"Level 4" DEF {
                    ^"Proficiency Bonus" INTEGER 2
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Rages" INTEGER 3
                    ^"Rage Damage" INTEGER 2
                    ^"Weapon Mastery" INTEGER 3
                }
                ^"Level 5" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Extra Attack", "Fast Movement"]
                    ^"Rages" INTEGER 3
                    ^"Rage Damage" INTEGER 2
                    ^"Weapon Mastery" INTEGER 3
                }
                ^"Level 6" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Subclass feature"]
                    ^"Rages" INTEGER 4
                    ^"Rage Damage" INTEGER 2
                    ^"Weapon Mastery" INTEGER 3
                }
                ^"Level 7" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Feral Instinct", "Instinctive Pounce"]
                    ^"Rages" INTEGER 4
                    ^"Rage Damage" INTEGER 2
                    ^"Weapon Mastery" INTEGER 3
                }
                ^"Level 8" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Rages" INTEGER 4
                    ^"Rage Damage" INTEGER 2
                    ^"Weapon Mastery" INTEGER 3
                }
                ^"Level 9" DEF {
                    ^"Proficiency Bonus" INTEGER 4
                    ^"Class Features" LIST OF STRING ["Brutal Strike"]
                    ^"Rages" INTEGER 4
                    ^"Rage Damage" INTEGER 3
                    ^"Weapon Mastery" INTEGER 3
                }
                ^"Level 10" DEF {
                    ^"Proficiency Bonus" INTEGER 4
                    ^"Class Features" LIST OF STRING ["Subclass feature"]
                    ^"Rages" INTEGER 4
                    ^"Rage Damage" INTEGER 3
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 11" DEF {
                    ^"Proficiency Bonus" INTEGER 4
                    ^"Class Features" LIST OF STRING ["Relentless Rage"]
                    ^"Rages" INTEGER 4
                    ^"Rage Damage" INTEGER 3
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 12" DEF {
                    ^"Proficiency Bonus" INTEGER 4
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Rages" INTEGER 5
                    ^"Rage Damage" INTEGER 3
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 13" DEF {
                    ^"Proficiency Bonus" INTEGER 5
                    ^"Class Features" LIST OF STRING ["Improved Brutal Strike"]
                    ^"Rages" INTEGER 5
                    ^"Rage Damage" INTEGER 3
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 14" DEF {
                    ^"Proficiency Bonus" INTEGER 5
                    ^"Class Features" LIST OF STRING ["Subclass feature"]
                    ^"Rages" INTEGER 5
                    ^"Rage Damage" INTEGER 3
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 15" DEF {
                    ^"Proficiency Bonus" INTEGER 5
                    ^"Class Features" LIST OF STRING ["Persistent Rage"]
                    ^"Rages" INTEGER 5
                    ^"Rage Damage" INTEGER 3
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 16" DEF {
                    ^"Proficiency Bonus" INTEGER 5
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Rages" INTEGER 5
                    ^"Rage Damage" INTEGER 4
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 17" DEF {
                    ^"Proficiency Bonus" INTEGER 6
                    ^"Class Features" LIST OF STRING ["Improved Brutal Strike"]
                    ^"Rages" INTEGER 6
                    ^"Rage Damage" INTEGER 4
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 18" DEF {
                    ^"Proficiency Bonus" INTEGER 6
                    ^"Class Features" LIST OF STRING ["Indomitable Might"]
                    ^"Rages" INTEGER 6
                    ^"Rage Damage" INTEGER 4
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 19" DEF {
                    ^"Proficiency Bonus" INTEGER 6
                    ^"Class Features" LIST OF STRING ["Epic Boon"]
                    ^"Rages" INTEGER 6
                    ^"Rage Damage" INTEGER 4
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 20" DEF {
                    ^"Proficiency Bonus" INTEGER 6
                    ^"Class Features" LIST OF STRING ["Primal Champion"]
                    ^"Rages" INTEGER 6
                    ^"Rage Damage" INTEGER 4
                    ^"Weapon Mastery" INTEGER 4
                }
            }
        }
        FEATURES {
            #tpNyog0y50KTG456DU1XyUFl ^"Level 1: Rage" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 1
                ^"Description"
                STRING "You can imbue yourself with a primal power called Rage, a force that grants you extraordinary might and resilience. You can enter it as a Bonus Action if you aren't wearing Heavy armor. You can enter your Rage the number of times shown for your Barbarian level in the Rages column of the Barbarian Features table. You regain one expended use when you finish a Short Rest, and you regain all expended uses when you finish a Long Rest.

While active, your Rage follows the rules below. Damage Resistance. You have Resistance to Bludgeoning, Piercing, and Slashing damage. Rage Damage. When you make an attack using Strength—with either a weapon or an Unarmed Strike—and deal damage to the target, you gain a bonus to the damage that increases as you gain levels as a Barbarian, as shown in the Rage Damage column of the Barbarian Features table. Strength Advantage. You have Advantage on Strength checks and Strength saving throws. No Concentration or Spells. You can't maintain Concentration, and you can't cast spells. Duration. The Rage lasts until the end of your next turn, and it ends early if you don Heavy armor or have the Incapacitated condition. If your Rage is still active on your next turn, you can extend the Rage for another round by doing one of the following:

• Make an attack roll against an enemy. • Force an enemy to make a saving throw. • Take a Bonus Action to extend your Rage.

Each time the Rage is extended, it lasts until the end of your next turn. You can maintain a Rage for up to 10 minutes."
            }
            #tCrXVqaGrJ6U6xHmmcxzr0zn ^"Level 1: Unarmored Defense" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 1
                ^"Description"
                STRING "While you aren't wearing any armor, your base Armor Class equals 10 plus your Dexterity and Constitution modifiers. You can use a Shield and still gain this benefit."
            }
            #tqrIovaSOV5Qa5C49nKeolZa ^"Level 1: Weapon Mastery" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 1
                ^"Description"
                STRING "Your training with weapons allows you to use the mastery properties of two kinds of Simple or Martial Melee weapons of your choice, such as Greataxes and Handaxes. Whenever you finish a Long Rest, you can practice weapon drills and change one of those weapon choices. When you reach certain Barbarian levels, you gain the ability to use the mastery properties of more kinds of weapons, as shown in the Weapon Mastery column of the Barbarian Features table."
            }
            #tn9hlrZtWndO0U0kGHZEXpN1 ^"Level 2: Danger Sense" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 2
                ^"Description"
                STRING "You gain an uncanny sense of when things aren't as they should be, giving you an edge when you dodge perils. You have Advantage on Dexterity saving throws unless you have the Incapacitated condition."
            }
            #t8jl23O7eY1igbSdK71Ns4BC ^"Level 2: Reckless Attack" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 2
                ^"Description"
                STRING "You can throw aside all concern for defense to attack with increased ferocity. When you make your first attack roll on your turn, you can decide to attack recklessly. Doing so gives you Advantage on attack rolls using Strength until the start of your next turn, but attack rolls against you have Advantage during that time."
            }
            #thRk07FvXsFzIVGDb1Ahr6e0 ^"Level 3: Barbarian Subclass" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 3
                ^"Description"
                STRING "You gain a Barbarian subclass of your choice. The Path of the Berserker subclass is detailed after this class's description. A subclass is a specialization that grants you features at certain Barbarian levels. For the rest of your career, you gain each of your subclass's features that are of your Barbarian level or lower."
            }
            #t3TnqWkfl21c2L0fARkmh6LR ^"Level 3: Primal Knowledge" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 3
                ^"Description"
                STRING "You gain proficiency in another skill of your choice from the skill list available to Barbarians at level 1. In addition, while your Rage is active, you can channel primal power when you attempt certain tasks; whenever you make an ability check using one of the following skills, you can make it as a Strength check even if it normally uses a different ability: Acrobatics, Intimidation, Perception, Stealth, or Survival. When you use this ability, your Strength represents primal power coursing through you, honing your agility, bearing, and senses."
            }
            #tVUgz94MDU4wTldlqs6bsx7L ^"Level 4: Ability Score Improvement" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 4
                ^"Description"
                STRING "You gain the Ability Score Improvement feat (see \"Feats\") or another feat of your choice for which you qualify. You gain this feature again at Barbarian levels 8, 12, and 16."
            }
            #tzrC5V0xa7Gk00hkKzwgjiXh ^"Level 5: Extra Attack" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 5
                ^"Description"
                STRING "You can attack twice instead of once whenever you take the Attack action on your turn."
            }
            #tK6RdD7dinJ4lXOug4Ks2pNf ^"Level 5: Fast Movement" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 5
                ^"Description"
                STRING "Your speed increases by 10 feet while you aren't wearing Heavy armor."
            }
            #the7yMaMCt5Aeu6cVFTr0qBV ^"Level 7: Feral Instinct" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 7
                ^"Description"
                STRING "Your instincts are so honed that you have Advantage on Initiative rolls."
            }
            #tfqGBsfTE45ClUN8OTfzYgn0 ^"Level 7: Instinctive Pounce" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 7
                ^"Description"
                STRING "As part of the Bonus Action you take to enter your Rage, you can move up to half your Speed."
            }
            #tBF1t0fbbkb3mhwg52PVR7Wl ^"Level 9: Brutal Strike" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 9
                ^"Description"
                STRING "If you use Reckless Attack, you can forgo any Advantage on one Strength-based attack roll of your choice on your turn. The chosen attack roll mustn't have Disadvantage. If the chosen attack roll hits, the target takes an extra 1d10 damage of the same type dealt by the weapon or Unarmed Strike, and you can cause one Brutal Strike effect of your choice. You have the following effect options. Forceful Blow. The target is pushed 15 feet straight away from you. You can then move up to half your Speed straight toward the target without provoking Opportunity Attacks.

Hamstring Blow. The target's Speed is reduced by 15 feet until the start of your next turn. A target can be affected by only one Hamstring Blow at a time—the most recent one."
            }
            #tx4jOQHz5w95idf8s2B5AbFS ^"Level 11: Relentless Rage" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 11
                ^"Description"
                STRING "Your Rage can keep you fighting despite grievous wounds. If you drop to 0 Hit Points while your Rage is active and don't die outright, you can make a DC 10 Constitution saving throw. If you succeed, your Hit Points instead change to a number equal to twice your Barbarian level. Each time you use this feature after the first, the DC increases by 5. When you finish a Short or Long Rest, the DC resets to 10."
            }
            #tQSHjAdl5b4IoHfQepm2gTDh ^"Level 13: Improved Brutal Strike" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 13
                ^"Description"
                STRING "You have honed new ways to attack furiously. The following effects are now among your Brutal Strike options. Staggering Blow. The target has Disadvantage on the next saving throw it makes, and it can't make Opportunity Attacks until the start of your next turn. Sundering Blow. Before the start of your next turn, the next attack roll made by another creature against the target gains a +5 bonus to the roll. An attack roll can gain only one Sundering Blow bonus."
            }
            #tCnqXcTsdgMELRT2AiKgFqrP ^"Level 15: Persistent Rage" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 15
                ^"Description"
                STRING "When you roll Initiative, you can regain all expended uses of Rage. After you regain uses of Rage in this way, you can't do so again until you finish a Long Rest. In addition, your Rage is so fierce that it now lasts for 10 minutes without you needing to do anything to extend it from round to round. Your Rage ends early if you have the Unconscious condition (not just the Incapacitated condition) or don Heavy armor."
            }
            #tzXkXxBU7V3wJSc3K6lyhuGa ^"Level 17: Improved Brutal Strike" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 17
                ^"Description"
                STRING "The extra damage of your Brutal Strike increases to 2d10. In addition, you can use two different Brutal Strike effects whenever you use your Brutal Strike feature."
            }
            #tPBRX6uzzbzXrh4SQkYIPYCD ^"Level 18: Indomitable Might" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 18
                ^"Description"
                STRING "If your total for a Strength check or Strength saving throw is less than your Strength score, you can use that score in place of the total."
            }
            #taHc7btVybrmstNFAbCBBQSn ^"Level 19: Epic Boon" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 19
                ^"Description"
                STRING "You gain an Epic Boon feat (see \"Feats\") or another feat of your choice for which you qualify. Boon of Irresistible Offense is recommended."
            }
            #txC9QU1B0bU6iU8yZN6CJSjH ^"Level 20: Primal Champion" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 20
                ^"Description"
                STRING "You embody primal power. Your Strength and Constitution scores increase by 4, to a maximum of 25."
            }
        }
    }
    # source: subclass (pages 30-31)
    #tAhtcTIH8423WRI5PKZzpC2a ^"Path of the Berserker" DEF {
        EXTENDS ^"Subclass"
        PROPERTIES {
            ^"Parent Class" STRING "Barbarian"
            ^"Tagline" STRING "Channel Rage into Violent Fury"
            ^"Description" STRING "Barbarians who walk the Path of the Berserker direct their Rage primarily toward violence. Their path is one of untrammeled fury, and they thrill in the chaos of battle as they allow their Rage to seize and empower them."
        }
        FEATURES {
            #tq9Ud1oTgRsWuZe2bsXiyeAB ^"Level 3: Frenzy" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 3
                ^"Description"
                STRING "If you use Reckless Attack while your Rage is active, you deal extra damage to the first target you hit on your turn with a Strength-based attack. To determine the extra damage, roll a number of d6s equal to your Rage Damage bonus, and add them together. The damage has the same type as the weapon or Unarmed Strike used for the attack."
            }
            #tlD7RwMJUxl469U8zQmfNZm3 ^"Level 6: Mindless Rage" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 6
                ^"Description"
                STRING "You have Immunity to the Charmed and Frightened conditions while your Rage is active. If you're Charmed or Frightened when you enter your Rage, the condition ends on you."
            }
            #t51eG3lcfb9G05JZ2npG4V1U ^"Level 10: Retaliation" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 10
                ^"Description"
                STRING "When you take damage from a creature that is within 5 feet of you, you can take a Reaction to make one melee attack against that creature, using a weapon or an Unarmed Strike."
            }
            #tdSNQkG8UOPzJxpnu6EGlYvV ^"Level 14: Intimidating Presence" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 14
                ^"Description"
                STRING "As a Bonus Action, you can strike terror into others with your menacing presence and primal power. When you do so, each creature of your choice in a 30-foot Emanation originating from you must make a Wisdom saving throw (DC 8 plus your Strength modifier and Proficiency Bonus). On a failed save, a creature has the Frightened condition for 1 minute. At the end of each of the Frightened creature's turns, the creature repeats the save, ending the effect on itself on a success. Once you use this feature, you can't use it again until you finish a Long Rest unless you expend a use of your Rage (no action required) to restore your use of it."
            }
        }
    }
    # source: class (pages 31-36)
    #tAthPbDT6x1ii2dBCGDG2LgO ^"Bard" DEF {
        EXTENDS ^"Class"
        PROPERTIES {
            ^"Description" STRING
            ^"Primary Ability" STRING "Charisma"
            ^"Hit Point Die" STRING "D8 per Bard level"
            ^"Saving Throw Proficiencies" LIST OF STRING ["Dexterity", "Charisma"]
            ^"Armor Training" LIST OF STRING ["Light"]
            ^"Weapon Proficiencies" LIST OF STRING ["Simple"]
            ^"Tool Proficiencies" LIST OF STRING ["Choose 3 Musical Instruments"]
            ^"Skill Choices" DEF {
                ^"Count" INTEGER 3
