    # source: spell (page 159)
    #t2RYsL4k5w28pXCbt5pjNHTW ^"Scorching Ray" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 2
            ^"School" STRING "Evocation"
