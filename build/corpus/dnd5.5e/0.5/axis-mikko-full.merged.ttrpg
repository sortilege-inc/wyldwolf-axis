    #tr7m6OCY5ywYEgdcp77Gzef8 ^"Acid Arrow" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 2
            ^"School" STRING "Evocation"
            ^"Casting Time" STRING "Action"
            ^"Range" STRING "90 feet"
            ^"Components" STRING "V, S, M (powdered rhubarb leaf)"
            ^"Duration" STRING "Instantaneous"
            ^"Description" STRING "A shimmering green arrow streaks toward a target within range and bursts in a spray of acid. Make a ranged spell attack against the target. On a hit, the target takes 4d4 Acid damage and 2d4 Acid damage at the end of its next turn. On a miss, the arrow splashes the target with acid for half as much of the initial damage only."
            ^"At Higher Levels" STRING "The damage (both initial and later) increases by 1d4 for each spell slot level above 2."
            ^"Classes" LIST OF STRING ["Wizard"]
        }
    }
