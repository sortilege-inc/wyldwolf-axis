                ^"Rarity"
                STRING "Rare"
                ^"Description"
                STRING "This onyx statuette of a dog can become a Mastiff for up to 6 hours. The mastiff has an Intelligence of 8 and can speak Common. It also has Blindsight with a range of 60 feet. Once it has been used, it can't be used again until 7 days have passed."
            }
            #tqGIWzKOWC5ctyAUilDTwQtL ^"Serpentine Owl" DEF {
                EXTENDS ^"Item Variant"
                ^"Rarity"
                STRING "Rare"
                ^"Description"
