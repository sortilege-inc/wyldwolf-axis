    # source: magic item (page 214)
    #t2pYUAS8jSVCaTLVanVLLh1x ^"Broom of Flying" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Wondrous Item"
            ^"Rarity" STRING "Uncommon"
            ^"Requires Attunement" BOOLEAN true
            ^"Description" STRING "This wooden broom functions like a mundane broom until you stand astride it and take a Magic action to make it hover beneath you, at which time it can be ridden in the air. It has a Fly Speed of 50 feet. It can carry up to 400 pounds, but its Fly Speed becomes 30 feet while carrying over 200 pounds. The broom stops hovering when you land or when you're no longer riding it. As a Magic action, you can send the broom to travel alone to a destination within 1 mile of you if you name the location and are familiar with it. The broom comes back to you when you take a Magic action and use a command word if the broom is still within 1 mile of you."
        }
    }
    # source: magic item (page 214)
    #tumfDgdCizx4uaDyuFNGbAEK ^"Candle of Invocation" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Wondrous Item"
            ^"Rarity" STRING "Very Rare"
            ^"Requires Attunement" BOOLEAN true
            ^"Description" STRING "This candle's magic is activated when the candle is lit, which requires a Magic action. After burning for 4 hours, the candle is destroyed. You can snuff it out early for use at a later time. Deduct the time it burned in increments of 1 minute from its total burn time. While lit, the candle sheds Dim Light in a 30-foot radius. While you are within that light, you have Advantage on D20 Tests. In addition, a Cleric or Druid in the light can cast level 1 spells they have prepared without expending spell slots. Alternatively, when you light the candle for the first time, you can cast *Gate* with it. Doing so destroys the candle. The portal created by the spell links to a particular Outer Plane chosen by the GM or determined by rolling on the following table (1d100):"
            ^"1d100 / Outer Plane" DEF {
                EXTENDS ^"Table"
                TABLE {
                COLUMNS ["1d100", "Outer Plane"]
                ROW ["01–05", "Abyss"]
                ROW ["06–10", "Acheron"]
                ROW ["11–17", "Arborea"]
                ROW ["18–25", "Arcadia"]
                ROW ["26–33", "Beastlands"]
                ROW ["34–41", "Bytopia"]
                ROW ["42–46", "Carceri"]
                ROW ["47–54", "Elysium"]
                ROW ["55–59", "Gehenna"]
                ROW ["60–64", "Hades"]
                ROW ["65–69", "Limbo"]
                ROW ["70–77", "Mechanus"]
                ROW ["78–85", "Mount Celestia"]
                ROW ["86–90", "Nine Hells"]
                ROW ["91–95", "Pandemonium"]
                ROW ["96–00", "Ysgard"]
            }
            }
        }
    }
