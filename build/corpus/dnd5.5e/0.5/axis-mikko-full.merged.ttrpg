    # source: spell (page 129)
    #tn4i6gkOht8UMk1BUql0RDpa ^"Eyebite" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 6
            ^"School" STRING "Necromancy"
            ^"Casting Time" STRING "Action"
            ^"Range" STRING "Self"
            ^"Components" STRING "V, S"
            ^"Duration" STRING "Concentration, up to 1 minute"
            ^"Concentration" BOOLEAN true
            ^"Description" STRING "For the duration, your eyes become an inky void. One creature of your choice within 60 feet of you that you can see must succeed on a Wisdom saving throw or be affected by one of the following effects of your choice for the duration. On each of your turns until the spell ends, you can take a Magic action to target another creature but can’t target a creature again if it has succeeded on a save against this casting of the spell. **Asleep.** The target has the Unconscious condition. It wakes up if it takes any damage or if another creature takes an action to shake it awake. **Panicked.** The target has the Frightened condition. On each of its turns, the Frightened target must take the Dash action and move away from you by the safest and shortest route available. If the target moves to a space at least 60 feet away from you where it can’t see you, this effect ends. **Sickened.** The target has the Poisoned condition."
            ^"Classes" LIST OF STRING ["Bard", "Sorcerer", "Warlock", "Wizard"]
        }
    }
    # source: spell (page 129)
    #tRsq7rvzqVawHUwoMs7DXcXE ^"Fabricate" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 4
            ^"School" STRING "Transmutation"
            ^"Casting Time" STRING "10 minutes"
            ^"Range" STRING "120 feet"
            ^"Components" STRING "V, S"
            ^"Duration" STRING "Instantaneous"
            ^"Description" STRING "You convert raw materials into products of the same material. For example, you can fabricate a wooden bridge from a clump of trees, a rope from a patch of hemp, or clothes from flax or wool. Choose raw materials that you can see within range. You can fabricate a Large or smaller object (contained within a 10-foot Cube or eight connected 5-foot Cubes) given a sufficient quantity of material. If you’re working with metal, stone, or another mineral substance, however, the fabricated object can be no larger than Medium (contained within a 5-foot Cube). The quality of any fabricated objects is based on the quality of the raw materials. Creatures and magic items can’t be created by this spell. You also can’t use it to create items that require a high degree of skill—such as weapons and armor—unless you have proficiency with the type of Artisan’s Tools used to craft such objects."
            ^"Classes" LIST OF STRING ["Wizard"]
        }
    }
