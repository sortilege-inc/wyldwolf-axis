    # source: magic item (page 253)
    #tBSFakcttJhWbivB2R9oHw5a ^"Wings of Flying" DEF {
        EXTENDS ^"Magic Item"
        PROPERTIES {
            ^"Item Type" STRING "Wondrous Item"
            ^"Rarity" STRING "Rare"
