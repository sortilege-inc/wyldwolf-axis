    #tHGEKWOk0kYwVCqCWl8UDWbi ^"Divine Word" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 7
            ^"School" STRING "Evocation"
            ^"Casting Time" STRING "Bonus Action"
            ^"Range" STRING "30 feet"
            ^"Components" STRING "V"
            ^"Duration" STRING "Instantaneous"
            ^"Description" STRING "You utter a word imbued with power from the Upper Planes. Each creature of your choice in range makes a Charisma saving throw. On a failed save, a target that has 50 Hit Points or fewer suffers an effect based on its current Hit Points, as shown in the Divine Word Effects table. Regardless of its Hit Points, a Celestial, an Elemental, a Fey, or a Fiend target that fails its save is forced back to its plane of origin (if it isn’t there already) and can’t return to the current plane for 24 hours by any means short of a *Wish* spell."
            ^"Divine Word Effects" DEF {
                EXTENDS ^"Table"
                TABLE {
                COLUMNS ["Hit Points", "Effect"]
                ROW ["0–20", "The target dies."]
                ROW ["21–30", "The target has the Blinded, Deafened, and Stunned conditions for 1 hour."]
                ROW ["31–40", "The target has the Blinded and Deafened conditions for 10 minutes."]
                ROW ["41–50", "The target has the Deafened condition for 1 minute."]
            }
            }
            ^"Classes" LIST OF STRING ["Cleric"]
        }
    }
    # source: spell (page 125)
    #tQBeZFjsrD1GYvi3Be7uAmYY ^"Dominate Beast" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 4
            ^"School" STRING "Enchantment"
            ^"Casting Time" STRING "Action"
            ^"Range" STRING "60 feet"
            ^"Components" STRING "V, S"
            ^"Duration" STRING "Concentration, up to 1 minute"
            ^"Concentration" BOOLEAN true
            ^"Description" STRING "One Beast you can see within range must succeed on a Wisdom saving throw or have the Charmed condition for the duration. The target has Advantage on the save if you or your allies are fighting it. Whenever the target takes damage, it repeats the save, ending the spell on itself on a success. You have a telepathic link with the Charmed target while the two of you are on the same plane of existence. On your turn, you can use this link to issue commands to the target (no action required), such as “Attack that creature,” “Move over there,” or “Fetch that object.” The target does its best to obey on its turn. If it completes an order and doesn’t receive further direction from you, it acts and moves as it likes, focusing on protecting itself. You can command the target to take a Reaction but must take your own Reaction to do so."
            ^"At Higher Levels" STRING "Your Concentration can last longer with a spell slot of level 5 (up to 10 minutes), 6 (up to 1 hour), or 7+ (up to 8 hours)."
            ^"Classes" LIST OF STRING ["Druid", "Ranger", "Sorcerer"]
        }
    }
