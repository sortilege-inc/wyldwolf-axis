            ^"At Higher Levels" STRING "The spell creates one more dart for each spell slot level above 1."
            ^"Classes" LIST OF STRING ["Sorcerer", "Wizard"]
        }
    }
    # source: spell (page 146)
    #t4CdWn9Lo6mAieux4cFZLX7d ^"Magic Mouth" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 2
            ^"School" STRING "Illusion"
            ^"Casting Time" STRING "1 minute or Ritual"
            ^"Range" STRING "30 feet"
            ^"Components" STRING "V, S, M (jade dust worth 10+ GP, which the spell consumes)"
            ^"Duration" STRING "Until dispelled"
            ^"Ritual" BOOLEAN true
            ^"Description" STRING "You implant a message within an object in range—a message that is uttered when a trigger condition is met. Choose an object that you can see and that isn’t being worn or carried by another creature. Then speak the message, which must be 25 words or fewer, though it can be delivered over as long as 10 minutes. Finally, determine the circumstance that will trigger the spell to deliver your message. When that trigger occurs, a magical mouth appears on the object and recites the message in your voice and at the same volume you spoke. If the object you chose has a mouth or something that looks like a mouth (for example, the mouth of a statue), the magical mouth appears there, so the words appear to come from the object’s mouth. When you cast this spell, you can have the spell end after it delivers its message, or it can remain and repeat its message whenever the trigger occurs. The trigger can be as general or as detailed as you like, though it must be based on visual or audible conditions that occur within 30 feet of the object. For example, you could instruct the mouth to speak when any creature moves within 30 feet of the object or when a silver bell rings within 30 feet of it."
            ^"Classes" LIST OF STRING ["Bard", "Wizard"]
        }
    }
    # source: spell (page 146)
    #trH8ReCS4YROZnuAsZsL5aJs ^"Magic Weapon" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 2
            ^"School" STRING "Transmutation"
            ^"Casting Time" STRING "Bonus Action"
            ^"Range" STRING "Touch"
            ^"Components" STRING "V, S"
            ^"Duration" STRING "1 hour"
            ^"Description" STRING "You touch a nonmagical weapon. Until the spell ends, that weapon becomes a magic weapon with a +1 bonus to attack rolls and damage rolls. The spell ends early if you cast it again."
            ^"At Higher Levels" STRING "The bonus increases to +2 with a level 3–5 spell slot. The bonus increases to +3 with a level 6+ spell slot."
            ^"Classes" LIST OF STRING ["Paladin", "Ranger", "Sorcerer", "Wizard"]
        }
    }
    # source: spell (page 147)
    #tf1KThexymrR4i0fD8VttJuG ^"Magnificent Mansion" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 7
            ^"School" STRING "Conjuration"
            ^"Casting Time" STRING "1 minute"
            ^"Range" STRING "300 feet"
            ^"Components" STRING "V, S, M (a miniature door worth 15+ GP)"
            ^"Duration" STRING "24 hours"
            ^"Description" STRING "You conjure a shimmering door in range that lasts for the duration. The door leads to an extradimensional dwelling and is 5 feet wide and 10 feet tall. You and any creature you designate when you cast the spell can enter the extradimensional dwelling as long as the door remains open. You can open or close it (no action required) if you are within 30 feet of it. While closed, the door is imperceptible. Beyond the door is a magnificent foyer with numerous chambers beyond. The dwelling’s atmosphere is clean, fresh, and warm. You can create any floor plan you like for the dwelling, but it can’t exceed 50 contiguous 10-foot Cubes. The place is furnished and decorated as you choose. It contains sufficient food to serve a ninecourse banquet for up to 100 people. Furnishings and other objects created by this spell dissipate into smoke if removed from it. A staff of 100 near-transparent servants attends all who enter. You determine the appearance of these servants and their attire. They are invulnerable and obey your commands. Each servant can perform tasks that a human could perform, but they can’t attack or take any action that would directly harm another creature. Thus the servants can fetch things, clean, mend, fold clothes, light fires, serve food, pour wine, and so on. The servants can’t leave the dwelling. When the spell ends, any creatures or objects left inside the extradimensional space are expelled into the unoccupied spaces nearest to the entrance."
            ^"Classes" LIST OF STRING ["Bard", "Wizard"]
        }
    }
    # source: spell (page 147)
    #tmlfjcZiM4s7UoAhQaPCoLRH ^"Major Image" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 3
            ^"School" STRING "Illusion"
            ^"Casting Time" STRING "Action"
            ^"Range" STRING "120 feet"
            ^"Components" STRING "V, S, M (a bit of fleece)"
            ^"Duration" STRING "Concentration, up to 10 minutes"
            ^"Concentration" BOOLEAN true
            ^"Description" STRING "You create the image of an object, a creature, or some other visible phenomenon that is no larger than a 20-foot Cube. The image appears at a spot that you can see within range and lasts for the duration. It seems real, including sounds, smells, and temperature appropriate to the thing depicted, but it can’t deal damage or cause conditions. If you are within range of the illusion, you can take a Magic action to cause the image to move to any other spot within range. As the image changes location, you can alter its appearance so that its movements appear natural for the image. For example, if you create an image of a creature and move it, you can alter the image so that it appears to be walking. Similarly, you can cause the illusion to make different sounds at different times, even making it carry on a conversation, for example. Physical interaction with the image reveals it to be an illusion, for things can pass through it. A creature that takes a Study action to examine the image can determine that it is an illusion with a successful Intelligence (Investigation) check against your spell save DC. If a creature discerns the illusion for what it is, the creature can see through the image, and its other sensory qualities become faint to the creature."
            ^"At Higher Levels" STRING "The spell lasts until dispelled, without requiring Concentration, if cast with a level 4+ spell slot."
            ^"Classes" LIST OF STRING ["Bard", "Sorcerer", "Warlock", "Wizard"]
        }
    }
    # source: spell (page 147)
