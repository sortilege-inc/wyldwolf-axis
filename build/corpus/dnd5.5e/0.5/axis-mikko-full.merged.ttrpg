BASE "dnd5.5e" {
    NAME "dnd5.5e — resolved composition"
    VERSION "0.5"
    # Generated by titterpig-synthesist from 20 source file(s).
    # Compiled artifact — do not edit; recompile from the composition manifest.
    # Source: System Reference Document 5.2.1 (Wizards of the Coast, CC-BY-4.0),
    # the 2024 revision of the fifth edition rules. A d20 game: roll 1d20 +
    # ability modifier + Proficiency Bonus vs a Difficulty Class (DC). This file
    # defines the shared vocabulary, the actor types (Creature -> Character /
    # Monster), and the framework types that the content files (species, classes,
    # spells, monsters, magic items, conditions, glossary, ...) EXTEND.
    # 
    # This is a DISTINCT BASE edition from dnd5e (SRD 5.1), not a revision of it.
    # Key 2024 deltas baked into the framework below: Species replace Races (no
    # ability score increase on species; that moved to Backgrounds); Backgrounds
    # grant an ability-score choice + an Origin Feat; Feats carry a Category;
    # Weapons carry a Mastery property; a formal Rules Glossary of tagged rules.
    # Sourcebook content lives in sibling dnd5.5e-0.4-*.ttrpg files.
    # ============================================================
    # CORE VOCABULARY — ABILITIES & CHECKS
    # ============================================================
    #dnd55eAbility0000001 ^"Ability" DEF {
        # The six ability scores. Every creature has all six; a D20 Test (check,
        # attack, or save) adds the relevant ability modifier (floor((score-10)/2)).
        ENUM ["Strength", "Dexterity", "Constitution", "Intelligence", "Wisdom", "Charisma"]
        DESCRIPTION "Strength (Str): physical power, athletic training.
            Dexterity (Dex): agility, reflexes, balance.
            Constitution (Con): health, stamina, vital force.
            Intelligence (Int): reasoning, memory, analysis.
            Wisdom (Wis): awareness, intuition, insight.
            Charisma (Cha): confidence, poise, force of personality."
    }
    #dnd55eAbilityScore01 ^"Ability Score" DEF {
        # A single ability's score. 1-20 for most; up to 30 for the mightiest.
        # The modifier is floor((score - 10) / 2).
        INTEGER MIN 1 MAX 30
    }
    #dnd55eProfBonus00001 ^"Proficiency Bonus" DEF {
        # Added to D20 Tests a creature is proficient with. Scales +2..+6 with
        # character level / monster CR.
        INTEGER MIN 2 MAX 9 DEFAULT 2
    }
    #dnd55eAdvantage0001 ^"Advantage State" DEF {
        # Roll two d20 and take the higher (Advantage) or lower (Disadvantage);
        # they cancel and never stack.
        ENUM ["Advantage", "Normal", "Disadvantage"]
    }
    #t64cFMhO5M3gTdmGDwn2QDSc ^"Skill" DEF {
        EXTENDS ^"Glossary Rule"
        PROPERTIES {
            ^"Tag" STRING
            ^"Description" STRING "A skill is an area of specialization associated with an ability check. If you have proficiency in a skill, you can add your Proficiency Bonus when you make an ability check associated with that skill. *See also* “Playing the Game” (“Proficiency”)."
        }
    }
