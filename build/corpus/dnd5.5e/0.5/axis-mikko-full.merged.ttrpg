                ROW ["Orb", "3 lb.", "20 GP"]
                ROW ["Rod", "2 lb.", "10 GP"]
                ROW ["Staff (also a Quarterstaff)", "4 lb.", "5 GP"]
                ROW ["Wand", "1 lb.", "10 GP"]
