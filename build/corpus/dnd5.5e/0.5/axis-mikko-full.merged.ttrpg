            ^"Duration" STRING "1 hour"
            ^"Ritual" BOOLEAN true
            ^"Description" STRING "For the duration, you understand the literal meaning of any language that you hear or see signed. You also understand any written language that you see, but you must be touching the surface on which the words are written. It takes about 1 minute to read one page of text. This spell doesn’t decode symbols or secret messages."
            ^"Classes" LIST OF STRING ["Bard", "Sorcerer", "Warlock", "Wizard"]
        }
    }
    # source: spell (page 117)
    #ti6u6UKhtCK5QwqRhlNAo4wY ^"Compulsion" DEF {
        EXTENDS ^"Spell"
        PROPERTIES {
            ^"Level" INTEGER 4
            ^"School" STRING "Enchantment"
            ^"Casting Time" STRING "Action"
            ^"Range" STRING "30 feet"
