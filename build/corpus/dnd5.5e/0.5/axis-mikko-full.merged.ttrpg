                ^"Charisma" INTEGER 16
            }
            ^"Armor Class" INTEGER 20
            ^"Initiative" DEF {
                ^"Modifier" INTEGER 3
                ^"Score" INTEGER 13
            }
            ^"Hit Points Note" STRING "Half the HP maximum of its summoner"
            ^"Speed" DEF {
                ^"Walk" INTEGER 60
                ^"Fly" INTEGER 60
                ^"Hover" BOOLEAN true
            }
            ^"Damage Immunities" LIST OF STRING ["Necrotic", "Poison"]
            ^"Condition Immunities" LIST OF STRING ["Charmed", "Exhaustion", "Frightened", "Paralyzed", "Petrified", "Poisoned", "Unconscious"]
            ^"Senses" DEF {
                ^"Truesight" INTEGER 60
                ^"Passive Perception" INTEGER 13
