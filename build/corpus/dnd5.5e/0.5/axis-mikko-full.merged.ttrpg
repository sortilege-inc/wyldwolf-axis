            #tZJZndk4gMxe5wFGkuq76OpT ^"Spellcasting" DEF {
                EXTENDS ^"Stat Block Feature"
                ^"Category"
                STRING "Action"
                ^"Description"
                STRING "The druid casts one of the following spells, using Wisdom as the spellcasting ability (spell save DC 13):

**At Will:** *Druidcraft*, *Speak with Animals*

**2/Day Each:** *Entangle*, *Thunderwave*

**1/Day Each:** *Animal Messenger*, *Longstrider*, *Moonbeam*"
            }
        }
    }
    # source: subclass (pages 46-47)
    #tbYzI8Oouk24177MZGr6k8IS ^"Circle of the Land" DEF {
        EXTENDS ^"Subclass"
        PROPERTIES {
            ^"Parent Class" STRING "Druid"
            ^"Tagline" STRING "Celebrate Connection to the Natural World"
            ^"Description" STRING "The Circle of the Land comprises mystics and sages who safeguard ancient knowledge and rites. These Druids meet within sacred circles of trees or standing stones to whisper primal secrets in Druidic. The circle’s wisest members preside as the chief priests of their communities."
        }
        FEATURES {
            #tO0vh9ZE7YRjy7cikkQD7PiY ^"Level 3: Circle of the Land Spells" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 3
                ^"Description"
                STRING "Whenever you finish a Long Rest, choose one type of land: arid, polar, temperate, or tropical. Consult the table below that corresponds to the chosen type; you have the spells listed for your Druid level and lower prepared."
                ^"Arid Land" DEF {
                    EXTENDS ^"Table"
                    TABLE {
                        COLUMNS ["Druid Level", "Circle Spells"]
                        ROW ["3", "Blur, Burning Hands, Fire Bolt"]
                        ROW ["5", "Fireball"]
                        ROW ["7", "Blight"]
                        ROW ["9", "Wall of Stone"]
                    }
                }
                ^"Polar Land" DEF {
                    EXTENDS ^"Table"
                    TABLE {
                        COLUMNS ["Druid Level", "Circle Spells"]
                        ROW ["3", "Fog Cloud, Hold Person, Ray of Frost"]
                        ROW ["5", "Sleet Storm"]
                        ROW ["7", "Ice Storm"]
                        ROW ["9", "Cone of Cold"]
                    }
                }
                ^"Temperate Land" DEF {
                    EXTENDS ^"Table"
                    TABLE {
                        COLUMNS ["Druid Level", "Circle Spells"]
                        ROW ["3", "Misty Step, Shocking Grasp, Sleep"]
                        ROW ["5", "Lightning Bolt"]
                        ROW ["7", "Freedom of Movement"]
                        ROW ["9", "Tree Stride"]
                    }
                }
                ^"Tropical Land" DEF {
                    EXTENDS ^"Table"
                    TABLE {
                        COLUMNS ["Druid Level", "Circle Spells"]
                        ROW ["3", "Acid Splash, Ray of Sickness, Web"]
                        ROW ["5", "Stinking Cloud"]
                        ROW ["7", "Polymorph"]
                        ROW ["9", "Insect Plague"]
                    }
                }
                ^"Nature’s Ward" DEF {
                    EXTENDS ^"Table"
                    TABLE {
                        COLUMNS ["Land Type", "Resistance"]
                        ROW ["Arid", "Fire"]
                        ROW ["Polar", "Cold"]
                        ROW ["Temperate", "Lightning"]
                        ROW ["Tropical", "Poison"]
                    }
                }
            }
            #tMJtDZxoEApVS3v0MmWVkfTa ^"Level 3: Land’s Aid" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 3
                ^"Description"
                STRING "As a Magic action, you can expend a use of your Wild Shape and choose a point within 60 feet of yourself. Vitality-giving flowers and life-draining thorns appear for a moment in a 10-foot-radius Sphere centered on that point. Each creature of your choice in the Sphere must make a Constitution saving throw against your spell save DC, taking 2d6 Necrotic damage on a failed save or half as much damage on a successful one. One creature of your choice in that area regains 2d6 Hit Points. The damage and healing increase by 1d6 when you reach Druid levels 10 (3d6) and 14 (4d6)."
            }
            #tmDxg75bDfs0skWNd3KSOef2 ^"Level 6: Natural Recovery" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 6
                ^"Description"
                STRING "You can cast one of the level 1+ spells that you have prepared from your Circle Spells feature without expending a spell slot, and you must finish a Long Rest before you do so again. In addition, when you finish a Short Rest, you can choose expended spell slots to recover. The spell slots can have a combined level that is equal to or less than half your Druid level (round up), and none of them can be level 6+. For example, if you’re a level 6 Druid, you can recover up to three levels’ worth of spell slots. You can recover a level 3 spell slot, a level 2 and a level 1 spell slot, or three level 1 spell slots. Once you recover spell slots with this feature, you can’t do so again until you finish a Long Rest."
            }
            #tL2IBO5pU7oayIHRi5ixpfLz ^"Level 10: Nature’s Ward" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 10
                ^"Description"
                STRING "You are immune to the Poisoned condition, and you have Resistance to a damage type associated with your current land choice in the Circle Spells feature, as shown in the Nature’s Ward table:"
            }
            #t6W6rb7GDNd8QpKpqPeAAIka ^"Level 14: Nature’s Sanctuary" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 14
                ^"Description"
                STRING "As a Magic action, you can expend a use of your Wild Shape and cause spectral trees and vines to appear in a 15-foot Cube on the ground within 120 feet of yourself. They last there for 1 minute or until you have the Incapacitated condition or die. You and your allies have Half Cover while in that area, and your allies gain the current Resistance of your Nature’s Ward while there. As a Bonus Action, you can move the Cube up to 60 feet to ground within 120 feet of yourself."
            }
        }
    }
    # source: class (pages 47-49)
    #tdyK4LTIqa27GnIbNxzWCfI7 ^"Fighter" DEF {
        EXTENDS ^"Class"
        PROPERTIES {
            ^"Description" STRING
            ^"Primary Ability" STRING "Strength or Dexterity"
            ^"Hit Point Die" STRING "D10 per Fighter level"
            ^"Saving Throw Proficiencies" LIST OF STRING ["Strength", "Constitution"]
            ^"Armor Training" LIST OF STRING ["Light", "Medium", "Heavy", "Shields"]
            ^"Weapon Proficiencies" LIST OF STRING ["Simple", "Martial"]
            ^"Weapon Mastery Count" INTEGER 3
            ^"Skill Choices" DEF {
                ^"Count" INTEGER 2
                ^"Options" LIST OF STRING ["Acrobatics", "Animal Handling", "Athletics", "History", "Insight", "Intimidation", "Persuasion", "Perception", "Survival"]
            }
            ^"Starting Equipment" DEF {
                ^"Option A" LIST OF STRING ["Chain Mail", "Greatsword", "Flail", "8 Javelins", "Dungeoneer's Pack", "4 GP"]
                ^"Option B" STRING "155 GP"
            }
            ^"Progression" DEF {
                ^"Level 1" DEF {
                    ^"Proficiency Bonus" INTEGER 2
                    ^"Class Features" LIST OF STRING ["Fighting Style", "Second Wind", "Weapon Mastery"]
                    ^"Second Wind" INTEGER 2
                    ^"Weapon Mastery" INTEGER 3
                }
                ^"Level 2" DEF {
                    ^"Proficiency Bonus" INTEGER 2
                    ^"Class Features" LIST OF STRING ["Action Surge (one use)", "Tactical Mind"]
                    ^"Second Wind" INTEGER 2
                    ^"Weapon Mastery" INTEGER 3
                }
                ^"Level 3" DEF {
                    ^"Proficiency Bonus" INTEGER 2
                    ^"Class Features" LIST OF STRING ["Fighter Subclass"]
                    ^"Second Wind" INTEGER 2
                    ^"Weapon Mastery" INTEGER 3
                }
                ^"Level 4" DEF {
                    ^"Proficiency Bonus" INTEGER 2
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Second Wind" INTEGER 3
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 5" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Extra Attack", "Tactical Shift"]
                    ^"Second Wind" INTEGER 3
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 6" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Second Wind" INTEGER 3
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 7" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Subclass feature"]
                    ^"Second Wind" INTEGER 3
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 8" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Second Wind" INTEGER 3
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 9" DEF {
                    ^"Proficiency Bonus" INTEGER 4
                    ^"Class Features" LIST OF STRING ["Indomitable (one use)", "Tactical Master"]
                    ^"Second Wind" INTEGER 3
                    ^"Weapon Mastery" INTEGER 4
                }
                ^"Level 10" DEF {
                    ^"Proficiency Bonus" INTEGER 4
                    ^"Class Features" LIST OF STRING ["Subclass feature"]
                    ^"Second Wind" INTEGER 4
                    ^"Weapon Mastery" INTEGER 5
                }
                ^"Level 11" DEF {
                    ^"Proficiency Bonus" INTEGER 4
                    ^"Class Features" LIST OF STRING ["Two Extra Attacks"]
                    ^"Second Wind" INTEGER 4
                    ^"Weapon Mastery" INTEGER 5
                }
                ^"Level 12" DEF {
                    ^"Proficiency Bonus" INTEGER 4
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Second Wind" INTEGER 4
                    ^"Weapon Mastery" INTEGER 5
                }
                ^"Level 13" DEF {
                    ^"Proficiency Bonus" INTEGER 5
                    ^"Class Features" LIST OF STRING ["Indomitable (two uses)", "Studied Attacks"]
                    ^"Second Wind" INTEGER 4
                    ^"Weapon Mastery" INTEGER 5
                }
                ^"Level 14" DEF {
                    ^"Proficiency Bonus" INTEGER 5
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Second Wind" INTEGER 4
                    ^"Weapon Mastery" INTEGER 5
                }
                ^"Level 15" DEF {
                    ^"Proficiency Bonus" INTEGER 5
                    ^"Class Features" LIST OF STRING ["Subclass feature"]
                    ^"Second Wind" INTEGER 4
                    ^"Weapon Mastery" INTEGER 5
                }
                ^"Level 16" DEF {
                    ^"Proficiency Bonus" INTEGER 5
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Second Wind" INTEGER 4
                    ^"Weapon Mastery" INTEGER 6
                }
                ^"Level 17" DEF {
                    ^"Proficiency Bonus" INTEGER 6
                    ^"Class Features" LIST OF STRING ["Action Surge (two uses)", "Indomitable (three uses)"]
                    ^"Second Wind" INTEGER 4
                    ^"Weapon Mastery" INTEGER 6
                }
                ^"Level 18" DEF {
                    ^"Proficiency Bonus" INTEGER 6
                    ^"Class Features" LIST OF STRING ["Subclass feature"]
                    ^"Second Wind" INTEGER 4
                    ^"Weapon Mastery" INTEGER 6
                }
                ^"Level 19" DEF {
                    ^"Proficiency Bonus" INTEGER 6
                    ^"Class Features" LIST OF STRING ["Epic Boon"]
                    ^"Second Wind" INTEGER 4
                    ^"Weapon Mastery" INTEGER 6
                }
                ^"Level 20" DEF {
                    ^"Proficiency Bonus" INTEGER 6
                    ^"Class Features" LIST OF STRING ["Three Extra Attacks"]
                    ^"Second Wind" INTEGER 4
                    ^"Weapon Mastery" INTEGER 6
                }
            }
        }
        FEATURES {
            #tJPD0lxiJouRZ0H87CSwQi6K ^"Level 1: Fighting Style" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 1
                ^"Description"
                STRING "You have honed your martial prowess and gain a Fighting Style feat of your choice (see \"Feats\"). Defense is recommended. Whenever you gain a Fighter level, you can replace the feat you chose with a different Fighting Style feat."
            }
            #tFofmn7LQqb3lbse8gicGvI2 ^"Level 1: Second Wind" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 1
                ^"Description"
                STRING "You have a limited well of physical and mental stamina that you can draw on. As a Bonus Action, you can use it to regain Hit Points equal to 1d10 plus your Fighter level. You can use this feature twice. You regain one expended use when you finish a Short Rest, and you regain all expended uses when you finish a Long Rest. When you reach certain Fighter levels, you gain more uses of this feature, as shown in the Second Wind column of the Fighter Features table."
            }
            #tTqEWZO9FQDaQfoRt6vHv9Dk ^"Level 1: Weapon Mastery" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 1
                ^"Description"
                STRING "Your training with weapons allows you to use the mastery properties of three kinds of Simple or Martial weapons of your choice. Whenever you finish a Long Rest, you can practice weapon drills and change one of those weapon choices. When you reach certain Fighter levels, you gain the ability to use the mastery properties of more kinds of weapons, as shown in the Weapon Mastery column of the Fighter Features table."
            }
            #t5QW2q4MIorM5WcGhsTl4p6x ^"Level 2: Action Surge" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 2
                ^"Description"
                STRING "You can push yourself beyond your normal limits for a moment. On your turn, you can take one additional action, except the Magic action. Once you use this feature, you can't do so again until you finish a Short or Long Rest. Starting at level 17, you can use it twice before a rest but only once on a turn."
            }
            #tNcGlwHbDIewX4tLT0xvoMjI ^"Level 2: Tactical Mind" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 2
                ^"Description"
                STRING "You have a mind for tactics on and off the battlefield. When you fail an ability check, you can expend a use of your Second Wind to push yourself toward success. Rather than regaining Hit Points, you roll 1d10 and add the number rolled to the ability check, potentially turning it into a success. If the check still fails, this use of Second Wind isn't expended."
            }
            #tIZofAYx9rUaIRb01k0G2oEV ^"Level 3: Fighter Subclass" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 3
                ^"Description"
                STRING "You gain a Fighter subclass of your choice. The Champion subclass is detailed after this class's description. A subclass is a specialization that grants you features at certain Fighter levels. For the rest of your career, you gain each of your subclass's features that are of your Fighter level or lower."
            }
            #tcWjEVE1WfvHuBQVlxhVe5cf ^"Level 4: Ability Score Improvement" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 4
                ^"Description"
                STRING "You gain the Ability Score Improvement feat (see \"Feats\") or another feat of your choice for which you qualify. You gain this feature again at Fighter levels 6, 8, 12, 14, and 16."
            }
            #tGMQnP6zMeK7l5k0LzROfoDS ^"Level 5: Extra Attack" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 5
                ^"Description"
                STRING "You can attack twice instead of once whenever you take the Attack action on your turn."
            }
            #t9MgBIeR95I8NnRhXmZU4Suf ^"Level 5: Tactical Shift" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 5
                ^"Description"
                STRING "Whenever you activate your Second Wind with a Bonus Action, you can move up to half your Speed without provoking Opportunity Attacks."
            }
            #tWJAu3zW5D4Hw9uD8kliH7vu ^"Level 9: Indomitable" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 9
                ^"Description"
                STRING "If you fail a saving throw, you can reroll it with a bonus equal to your Fighter level. You must use the new roll, and you can't use this feature again until you finish a Long Rest. You can use this feature twice before a Long Rest starting at level 13 and three times before a Long Rest starting at level 17."
            }
            #tEEr4kLtzoDd5WuIyJz7ztSd ^"Level 9: Tactical Master" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 9
                ^"Description"
                STRING "When you attack with a weapon whose mastery property you can use, you can replace that property with the Push, Sap, or Slow property for that attack."
            }
            #ttLutqyKRYaQm6MYwB91lGfw ^"Level 11: Two Extra Attacks" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 11
                ^"Description"
                STRING "You can attack three times instead of once whenever you take the Attack action on your turn."
            }
            #tp1iH0wqmMVpnQfGYlSvXOUJ ^"Level 13: Studied Attacks" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 13
                ^"Description"
                STRING "You study your opponents and learn from each attack you make. If you make an attack roll against a creature and miss, you have Advantage on your next attack roll against that creature before the end of your next turn."
            }
            #tNCOUvrxAQ0VdOh2FbQwmzj5 ^"Level 19: Epic Boon" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 19
                ^"Description"
                STRING "You gain an Epic Boon feat (see \"Feats\") or another feat of your choice for which you qualify. Boon of Combat Prowess is recommended."
            }
            #tgVV86YdriPf3AKG6OYGbc2x ^"Level 20: Three Extra Attacks" DEF {
                EXTENDS ^"Class Feature"
                ^"Level"
                INTEGER 20
                ^"Description"
                STRING "You can attack four times instead of once whenever you take the Attack action on your turn."
            }
        }
    }
    # source: subclass (pages 49-52)
    #tMcIWq2eroPQCXA1Fl9iY267 ^"Champion" DEF {
        EXTENDS ^"Subclass"
        PROPERTIES {
            ^"Parent Class" STRING "Fighter"
            ^"Tagline" STRING "Pursue Physical Excellence in Combat"
            ^"Description" STRING "A Champion focuses on the development of martial prowess in a relentless pursuit of victory. Champions combine rigorous training with physical excellence to deal devastating blows, withstand peril, and garner glory. Whether in athletic contests or bloody battle, Champions strive for the crown of the victor."
        }
        FEATURES {
            #twoCZe6I1bt0Cpr1kOnSrQZl ^"Level 3: Improved Critical" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 3
                ^"Description"
                STRING "Your attack rolls with weapons and Unarmed Strikes can score a Critical Hit on a roll of 19 or 20 on the d20."
            }
            #tCAdQhnmUWJSgsJYyj6wFNYm ^"Level 3: Remarkable Athlete" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 3
                ^"Description"
                STRING "Thanks to your athleticism, you have Advantage on Initiative rolls and Strength (Athletics) checks. In addition, immediately after you score a Critical Hit, you can move up to half your Speed without provoking Opportunity Attacks."
            }
            #teisrjvp4eifC78OprpzlxFc ^"Level 7: Additional Fighting Style" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 7
                ^"Description"
                STRING "You gain another Fighting Style feat of your choice."
            }
            #ti9mT0pjYJID0BTWBqS7iMPP ^"Level 10: Heroic Warrior" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 10
                ^"Description"
                STRING "The thrill of battle drives you toward victory. During combat, you can give yourself Heroic Inspiration whenever you start your turn without it."
            }
            #tmfcJvd8kCdUDULNQo0wARJY ^"Level 15: Superior Critical" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 15
                ^"Description"
                STRING "Your attack rolls with weapons and Unarmed Strikes can now score a Critical Hit on a roll of 18–20 on the d20."
            }
            #tMVNrG7rggENmZi6yHdPxMb8 ^"Level 18: Survivor" DEF {
                EXTENDS ^"Subclass Feature"
                ^"Level"
                INTEGER 18
                ^"Description"
                STRING "You attain the pinnacle of resilience in battle, giving you these benefits. **Defy Death.** You have Advantage on Death Saving Throws. Moreover, when you roll 18–20 on a Death Saving Throw, you gain the benefit of rolling a 20 on it. **Heroic Rally.** At the start of each of your turns, you regain Hit Points equal to 5 plus your Constitution modifier if you are Bloodied and have at least 1 Hit Point."
            }
        }
    }
    # source: class (pages 49-53)
    #to7RPQifW6DBYWFzp76BrsKB ^"Monk" DEF {
        EXTENDS ^"Class"
        PROPERTIES {
            ^"Description" STRING
            ^"Primary Ability" STRING "Dexterity and Wisdom"
            ^"Hit Point Die" STRING "D8 per Monk level"
            ^"Saving Throw Proficiencies" LIST OF STRING ["Strength", "Dexterity"]
            ^"Weapon Proficiencies" LIST OF STRING ["Simple weapons", "Martial weapons that have the Light property"]
            ^"Tool Proficiencies" LIST OF STRING ["Choose one type of Artisan's Tools or Musical Instrument (see \"Equipment\")"]
            ^"Skill Choices" DEF {
                ^"Count" INTEGER 2
                ^"Options" LIST OF STRING ["Acrobatics", "Athletics", "History", "Insight", "Religion", "Stealth"]
            }
            ^"Starting Equipment" DEF {
                ^"Option A" LIST OF STRING ["Spear", "5 Daggers", "Artisan's Tools or Musical Instrument chosen for the tool proficiency above", "Explorer's Pack", "11 GP"]
                ^"Option B" STRING "50 GP"
            }
            ^"Progression" DEF {
                ^"Level 1" DEF {
                    ^"Proficiency Bonus" INTEGER 2
                    ^"Class Features" LIST OF STRING ["Martial Arts", "Unarmored Defense"]
                    ^"Martial Arts" STRING "1d6"
                }
                ^"Level 2" DEF {
                    ^"Proficiency Bonus" INTEGER 2
                    ^"Class Features" LIST OF STRING ["Monk’s Focus", "Unarmored Movement", "Uncanny Metabolism"]
                    ^"Martial Arts" STRING "1d6"
                    ^"Focus Points" INTEGER 2
                    ^"Unarmored Movement" STRING "+10 ft."
                }
                ^"Level 3" DEF {
                    ^"Proficiency Bonus" INTEGER 2
                    ^"Class Features" LIST OF STRING ["Deflect Attacks", "Monk Subclass"]
                    ^"Martial Arts" STRING "1d6"
                    ^"Focus Points" INTEGER 3
                    ^"Unarmored Movement" STRING "+10 ft."
                }
                ^"Level 4" DEF {
                    ^"Proficiency Bonus" INTEGER 2
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement", "Slow Fall"]
                    ^"Martial Arts" STRING "1d6"
                    ^"Focus Points" INTEGER 4
                    ^"Unarmored Movement" STRING "+10 ft."
                }
                ^"Level 5" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Extra Attack", "Stunning Strike"]
                    ^"Martial Arts" STRING "1d8"
                    ^"Focus Points" INTEGER 5
                    ^"Unarmored Movement" STRING "+10 ft."
                }
                ^"Level 6" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Empowered Strikes", "Subclass feature"]
                    ^"Martial Arts" STRING "1d8"
                    ^"Focus Points" INTEGER 6
                    ^"Unarmored Movement" STRING "+15 ft."
                }
                ^"Level 7" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Evasion"]
                    ^"Martial Arts" STRING "1d8"
                    ^"Focus Points" INTEGER 7
                    ^"Unarmored Movement" STRING "+15 ft."
                }
                ^"Level 8" DEF {
                    ^"Proficiency Bonus" INTEGER 3
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Martial Arts" STRING "1d8"
                    ^"Focus Points" INTEGER 8
                    ^"Unarmored Movement" STRING "+15 ft."
                }
                ^"Level 9" DEF {
                    ^"Proficiency Bonus" INTEGER 4
                    ^"Class Features" LIST OF STRING ["Acrobatic Movement"]
                    ^"Martial Arts" STRING "1d8"
                    ^"Focus Points" INTEGER 9
                    ^"Unarmored Movement" STRING "+15 ft."
                }
                ^"Level 10" DEF {
                    ^"Proficiency Bonus" INTEGER 4
                    ^"Class Features" LIST OF STRING ["Heightened Focus", "Self-Restoration"]
                    ^"Martial Arts" STRING "1d8"
                    ^"Focus Points" INTEGER 10
                    ^"Unarmored Movement" STRING "+20 ft."
                }
                ^"Level 11" DEF {
                    ^"Proficiency Bonus" INTEGER 4
                    ^"Class Features" LIST OF STRING ["Subclass feature"]
                    ^"Martial Arts" STRING "1d10"
                    ^"Focus Points" INTEGER 11
                    ^"Unarmored Movement" STRING "+20 ft."
                }
                ^"Level 12" DEF {
                    ^"Proficiency Bonus" INTEGER 4
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Martial Arts" STRING "1d10"
                    ^"Focus Points" INTEGER 12
                    ^"Unarmored Movement" STRING "+20 ft."
                }
                ^"Level 13" DEF {
                    ^"Proficiency Bonus" INTEGER 5
                    ^"Class Features" LIST OF STRING ["Deflect Energy"]
                    ^"Martial Arts" STRING "1d10"
                    ^"Focus Points" INTEGER 13
                    ^"Unarmored Movement" STRING "+20 ft."
                }
                ^"Level 14" DEF {
                    ^"Proficiency Bonus" INTEGER 5
                    ^"Class Features" LIST OF STRING ["Disciplined Survivor"]
                    ^"Martial Arts" STRING "1d10"
                    ^"Focus Points" INTEGER 14
                    ^"Unarmored Movement" STRING "+25 ft."
                }
                ^"Level 15" DEF {
                    ^"Proficiency Bonus" INTEGER 5
                    ^"Class Features" LIST OF STRING ["Perfect Focus"]
                    ^"Martial Arts" STRING "1d10"
                    ^"Focus Points" INTEGER 15
                    ^"Unarmored Movement" STRING "+25 ft."
                }
                ^"Level 16" DEF {
                    ^"Proficiency Bonus" INTEGER 5
                    ^"Class Features" LIST OF STRING ["Ability Score Improvement"]
                    ^"Martial Arts" STRING "1d10"
                    ^"Focus Points" INTEGER 16
                    ^"Unarmored Movement" STRING "+25 ft."
                }
                ^"Level 17" DEF {
                    ^"Proficiency Bonus" INTEGER 6
                    ^"Class Features" LIST OF STRING ["Subclass feature"]
                    ^"Martial Arts" STRING "1d12"
                    ^"Focus Points" INTEGER 17
                    ^"Unarmored Movement" STRING "+25 ft."
                }
                ^"Level 18" DEF {
                    ^"Proficiency Bonus" INTEGER 6
                    ^"Class Features" LIST OF STRING ["Superior Defense"]
